<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@(string.IsNullOrEmpty((string)ViewBag.Title) ? "GreenRent" : (string)ViewBag.Title + " - GreenRent")</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body ng-app="app" ng-controller="controller">
    <div class="hidden" aria-hidden="true">@Html.AntiForgeryToken()</div>

    <div ng-show="toastShow"
         ng-cloak
         role="status"
         style="animation: slideDown 0.5s ease-in-out"
         class="fixed top-4 right-4 z-[300] flex items-center gap-3 w-[350px] max-w-[calc(100vw-2rem)] rounded-2xl border bg-white px-5 py-4 shadow-sm transition-all duration-300"
         ng-class="{'border-green-200': toast.type === 'success', 'border-red-200': toast.type === 'error', 'border-blue-200': toast.type === 'info'}">
        <span class="text-sm font-medium"
              ng-class="{'text-green-700': toast.type === 'success', 'text-red-700': toast.type === 'error', 'text-blue-700': toast.type === 'info'}">
            {{ toast.message }}
        </span>
    </div>

    <style>
        :root {
            --font-size: 16px;
            --background: #ffffff; /* Pure white background */
            --foreground: #064e3b; /* Very dark green for main text */
            --primary: #16a34a; /* Vibrant Green (Tailwind green-600) for buttons & user bubbles */
            --primary-foreground: #ffffff; /* White text on green */
            --secondary: #dcfce7; /* Light mint green */
            --secondary-foreground: #14532d; /* Dark forest green */
            --muted: #f0fdf4; /* Very light green background for bot bubbles and header */
            --muted-foreground: #15803d; /* Medium green for subtext/icons */
            --accent: #dcfce7; /* Mint green for hover states */
            --accent-foreground: #16a34a;
            --destructive: #ef4444; /* Red for the unread notification badge */
            --destructive-foreground: #ffffff;
            --border: #bbf7d0; /* Soft green for borders */
            --input: transparent;
            --input-background: #ffffff; /* White background for the text input */
            --radius: 1rem;
        }

        [ng\:cloak], [ng-cloak], [data-ng-cloak], [x-ng-cloak], .ng-cloak, .x-ng-cloak {
            display: none !important;
        }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(1px);
            }
        }
    </style>

    <div class="flex" ng-init="initChat()">
        <div id="admin-sidebar" class="hidden sm:flex flex-col bg-slate-800 transition-all duration-300 flex-shrink-0 h-screen sticky top-0"
             ng-class="sidebarCollapsed ? 'w-16' : 'w-64'">

            <div class="px-4 py-5 border-b border-slate-700 overflow-hidden">
                <div class="w-full h-16 rounded-xl overflow-hidden" ng-show="!sidebarCollapsed" ng-cloak>
                    <img src="https://i.imgur.com/Y6opN46.png"
                         alt="UnityRent Logo"
                         class="w-full h-full object-cover object-center" />
                </div>
                <div ng-show="sidebarCollapsed" class="flex justify-center" ng-cloak>
                    <div class="w-9 h-9 bg-green-600 rounded-xl flex items-center justify-center">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" /><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" /><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" /></svg>
                    </div>
                </div>
            </div>

            <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
                <button ng-click="goTo('AdminDashboard')"
                        class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition-all"
                        ng-class="currentPage == 'dashboard' ? 'bg-green-600 text-white' : 'text-slate-300 hover:bg-slate-700 hover:text-white'"
                        title="Dashboard">
                    <svg class="flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
                    <span ng-show="!sidebarCollapsed" ng-cloak>Dashboard</span>
                </button>

                <button ng-click="goTo('AdminManagers')"
                        class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition-all"
                        ng-class="currentPage == 'propertymanagers' ? 'bg-green-600 text-white' : 'text-slate-300 hover:bg-slate-700 hover:text-white'"
                        title="Managers">
                    <svg class="flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    <span ng-show="!sidebarCollapsed" ng-cloak>Managers</span>
                </button>

                <button ng-click="goTo('AdminTables')"
                        class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition-all"
                        ng-class="currentPage == 'table' ? 'bg-green-600 text-white' : 'text-slate-300 hover:bg-slate-700 hover:text-white'"
                        title="Look up table">
                    <svg class="flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
                    <span ng-show="!sidebarCollapsed" ng-cloak>Amenities</span>
                </button>

                <button ng-click="goTo('AdminLogs')"
                        class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition-all"
                        ng-class="currentPage == 'audit' ? 'bg-green-600 text-white' : 'text-slate-300 hover:bg-slate-700 hover:text-white'"
                        title="Audit trail">
                    <svg class="flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    <span ng-show="!sidebarCollapsed" ng-cloak>Audit trail</span>
                </button>
            </nav>

            <div class="px-3 py-4 border-t border-slate-700 space-y-1">
                <button ng-click="sidebarCollapsed = !sidebarCollapsed"
                        class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-slate-400 hover:bg-slate-700 hover:text-white transition-all"
                        title="Toggle Sidebar">
                    <svg class="flex-shrink-0 transition-transform duration-300"
                         ng-class="sidebarCollapsed ? 'rotate-180' : ''"
                         width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="15 18 9 12 15 6" />
                    </svg>
                    <span ng-show="!sidebarCollapsed" ng-cloak>Collapse</span>
                </button>

                <button ng-click="handleLogout()"
                        class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-red-400 hover:bg-red-900/20 hover:text-red-300 transition-all"
                        title="Logout">
                    <svg class="flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                    <span ng-show="!sidebarCollapsed" ng-cloak>Logout</span>
                </button>

                <div class="flex items-center gap-2 px-3 py-2" ng-show="!sidebarCollapsed" ng-cloak>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400 flex-shrink-0">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
                    </svg>
                    <p class="text-xs text-slate-400 font-medium tracking-widest uppercase">Admin</p>
                </div>
            </div>
        </div>

        <div class="sm:hidden fixed bottom-0 left-0 right-0 z-50 bg-slate-800 border-t border-slate-700 flex items-center justify-around px-2 py-2">
            <button ng-click="goTo('AdminDashboard')" class="flex flex-col items-center gap-0.5 px-2 py-1.5 rounded-xl transition-all" ng-class="currentPage == 'dashboard' ? 'text-green-400' : 'text-slate-400 hover:text-white'">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
                <span class="text-[10px]">Dashboard</span>
            </button>
            <button ng-click="goTo('AdminManagers')" class="flex flex-col items-center gap-0.5 px-2 py-1.5 rounded-xl transition-all" ng-class="currentPage == 'propertymanagers' ? 'text-green-400' : 'text-slate-400 hover:text-white'">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                <span class="text-[10px]">Managers</span>
            </button>
            <button ng-click="goTo('AdminTables')" class="flex flex-col items-center gap-0.5 px-2 py-1.5 rounded-xl transition-all" ng-class="currentPage == 'table' ? 'text-green-400' : 'text-slate-400 hover:text-white'">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
                <span class="text-[10px]">Amenities</span>
            </button>
            <button ng-click="goTo('AdminLogs')" class="flex flex-col items-center gap-0.5 px-2 py-1.5 rounded-xl transition-all" ng-class="currentPage == 'audit' ? 'text-green-400' : 'text-slate-400 hover:text-white'">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                <span class="text-[10px]">Audit</span>
            </button>
            <button ng-click="handleLogout()" class="flex flex-col items-center gap-0.5 px-2 py-1.5 rounded-xl text-red-400 hover:text-red-300 transition-all">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                <span class="text-[10px]">Logout</span>
            </button>
        </div>

        <div class="w-full min-w-0">
            @RenderBody()
        </div>

        <script src="~/Scripts/jquery-3.7.0.min.js"></script>
        <script src="~/Scripts/angular.min.js"></script>
        <script src="@Url.Content("~/Scripts/Scripts/Module.js")?v=20260911-amenities-submit-fix"></script>
        <script src="@Url.Content("~/Scripts/Scripts/InputRules.js?v=20261028-input-rules")"></script>
        <script src="@Url.Content("~/Scripts/Scripts/Service.js")?v=20260911-amenities-submit-fix"></script>
        <script src="@Url.Content("~/Scripts/Scripts/Controller.js?v=20261028-input-rules")"></script>
        <script src="~/Scripts/Chart.min.js"></script>
        <script src="~/Scripts/angular-chart.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</body>
</html>
