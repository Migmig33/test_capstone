<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@(string.IsNullOrEmpty((string)ViewBag.Title) ? "GreenRent" : (string)ViewBag.Title + " - GreenRent")</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body ng-app="app" ng-controller="controller">
    <style>
        :root {
            --font-size: 16px;
            --background: #ffffff;
            --foreground: oklch(0.145 0 0);
            --card: #ffffff;
            --card-foreground: oklch(0.145 0 0);
            --popover: oklch(1 0 0);
            --popover-foreground: oklch(0.145 0 0);
            --primary: #030213;
            --primary-foreground: oklch(1 0 0);
            --secondary: oklch(0.95 0.0058 264.53);
            --secondary-foreground: #030213;
            --muted: #ececf0;
            --muted-foreground: #717182;
            --accent: #e9ebef;
            --accent-foreground: #030213;
            --destructive: #d4183d;
            --destructive-foreground: #ffffff;
            --border: rgba(0, 0, 0, 0.1);
            --input: transparent;
            --input-background: #f3f3f5;
            --switch-background: #cbced4;
            --font-weight-medium: 500;
            --font-weight-normal: 400;
            --ring: oklch(0.708 0 0);
            --chart-1: oklch(0.646 0.222 41.116);
            --chart-2: oklch(0.6 0.118 184.704);
            --chart-3: oklch(0.398 0.07 227.392);
            --chart-4: oklch(0.828 0.189 84.429);
            --chart-5: oklch(0.769 0.188 70.08);
            --radius: 0.625rem;
            --sidebar: oklch(0.985 0 0);
            --sidebar-foreground: oklch(0.145 0 0);
            --sidebar-primary: #030213;
            --sidebar-primary-foreground: oklch(0.985 0 0);
            --sidebar-accent: oklch(0.97 0 0);
            --sidebar-accent-foreground: oklch(0.205 0 0);
            --sidebar-border: oklch(0.922 0 0);
            --sidebar-ring: oklch(0.708 0 0);
            --font-size: 16px;
            --background: #ffffff; /* Pure white background */
            --foreground: #064e3b; /* Very dark green for main text */
            --primary: #16a34a; /* Vibrant Green (Tailwind green-600) for buttons & user bubbles */
            --primary-foreground: #ffffff; /* White text on green */
            --secondary: #dcfce7; /* Light mint green */
            --secondary-foreground: #14532d; /* Dark forest green */
            --muted: #f0fdf4; /* Very light green background for bot bubbles and header */
            --muted-foreground: #15803d; /* Medium green for subtext/icons */
            --accent: #dcfce7; /* Mint green for hover states */
            --accent-foreground: #16a34a;
            --destructive: #ef4444; /* Red for the unread notification badge */
            --destructive-foreground: #ffffff;
            --border: #bbf7d0; /* Soft green for borders */
            --input: transparent;
            --input-background: #ffffff; /* White background for the text input */
            --radius: 1rem;
        }

        [ng\:cloak], [ng-cloak], [data-ng-cloak], [x-ng-cloak], .ng-cloak, .x-ng-cloak {
            display: none !important;
        }
    </style>
    <header ng-init="loadVisitor()" class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-100 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">

                <button type="button" ng-click="goTo('Home')" class="flex items-center gap-2 group focus:outline-none focus:ring-2 focus:ring-green-500 rounded-lg" aria-label="Go to renter home">
                    <div class="w-8 h-8 bg-gradient-to-br from-green-600 to-green-800 rounded-lg flex items-center justify-center shadow">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                            <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
                            <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
                            <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
                            <path d="M10 6h4" />
                            <path d="M10 10h4" />
                            <path d="M10 14h4" />
                            <path d="M10 18h4" />
                        </svg>
                    </div>
                    <span class="text-slate-900 text-lg font-bold">
                        Green<span class="text-green-600">Rent</span>
                    </span>
                </button>

                <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
                    <button ng-click="goTo('Home')" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm transition-all focus:outline-none focus:ring-2 focus:ring-green-500" ng-class="   currentPage == 'Home' ? ' bg-green-50 text-green-700 font-medium' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                            <polyline points="9 22 9 12 15 12 15 22" />
                        </svg>
                        Home
                    </button>

                    <button ng-click="goTo('Browse')" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm transition-all focus:outline-none focus:ring-2 focus:ring-green-500" ng-class="currentPage == 'Browse' ? ' bg-green-50 text-green-700 font-medium' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' ">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
                            <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
                            <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
                            <path d="M10 6h4" />
                            <path d="M10 10h4" />
                            <path d="M10 14h4" />
                            <path d="M10 18h4" />
                        </svg>
                        Browse Units
                    </button>

                    <button ng-click="goTo('MBookings')" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm transition-all focus:outline-none focus:ring-2 focus:ring-green-500" ng-class="currentPage == 'Bookings' ? ' bg-green-50 text-green-700 font-medium' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' ">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                            <line x1="16" x2="16" y1="2" y2="6" />
                            <line x1="8" x2="8" y1="2" y2="6" />
                            <line x1="3" x2="21" y1="10" y2="10" />
                        </svg>
                        My Bookings
                    </button>
                </nav>

                <div class="flex items-center gap-2">
                    <div ng-if="visitorName" class="flex items-center gap-2" ng-cloak>
                        <span class="text-xs text-slate-500">
                            Signed in as <span class="font-medium text-slate-700">{{ visitorName }}</span>
                        </span>
                        <button ng-click="logoutVisitor()"
                                class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-sm text-red-600 bg-red-50 hover:bg-red-100 transition-all focus:outline-none focus:ring-2 focus:ring-red-400">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                <polyline points="16 17 21 12 16 7" />
                                <line x1="21" x2="9" y1="12" y2="12" />
                            </svg>
                            Logout
                        </button>
                    </div>

                    <button ng-click="goTo('Auth')" class="hidden sm:flex items-center gap-1.5 px-3 py-2 rounded-xl text-sm bg-green-50 text-green-700 hover:bg-green-100 transition-all focus:outline-none focus:ring-2 focus:ring-green-500" ng-cloak>
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <circle cx="12" cy="10" r="3" />
                            <path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662" />
                        </svg>
                        Tenant Login
                    </button>

                    <!-- Hamburger (Angular-driven) -->
                    <button ng-click="mobileMenuOpen = !mobileMenuOpen"
                            class="md:hidden p-2 rounded-xl hover:bg-slate-100 transition-all focus:outline-none focus:ring-2 focus:ring-green-500"
                            aria-label="Open menu">
                        <svg ng-show="!mobileMenuOpen" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="4" x2="20" y1="12" y2="12" />
                            <line x1="4" x2="20" y1="6" y2="6" />
                            <line x1="4" x2="20" y1="18" y2="18" />
                        </svg>
                        <svg ng-show="mobileMenuOpen" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 6 6 18" />
                            <path d="m6 6 12 12" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Mobile menu (Angular-driven) -->
            <div ng-show="mobileMenuOpen" class="md:hidden border-t border-slate-100 py-3 space-y-1" ng-cloak>
                <button ng-click="goTo('Home'); mobileMenuOpen = false"
                        class="w-full flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm text-slate-700 hover:bg-slate-50 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                    Home
                </button>
                <button ng-click="goTo('Browse'); mobileMenuOpen = false"
                        class="w-full flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm text-slate-700 hover:bg-slate-50 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" /><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" /><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" /></svg>
                    Browse Units
                </button>
                <button ng-click="goTo('MBookings'); mobileMenuOpen = false"
                        class="w-full flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm text-slate-700 hover:bg-slate-50 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><line x1="16" x2="16" y1="2" y2="6" /><line x1="8" x2="8" y1="2" y2="6" /><line x1="3" x2="21" y1="10" y2="10" /></svg>
                    My Bookings
                </button>
                <button ng-click="goTo('Auth'); mobileMenuOpen = false"
                        class="w-full flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm text-green-700 bg-green-50 hover:bg-green-100 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="10" r="3" /><path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662" /></svg>
                    Tenant Login
                </button>
            </div>
        </div>
    </header>
    <div>
        @RenderBody()
    </div>
    <div class="fixed bottom-6 right-6 z-50 flex flex-col items-end pointer-events-none" ng-init="chatOpen = false; unread = 0; initRenterChat(); ">

        <div class="fixed bottom-6 right-6 z-50 flex flex-col items-end pointer-events-none" ng-init="chatOpen = false; unread = 0" ng-cloak>

            <!-- Chat Window -->
            <!-- FIX: Added 'opacity-0 scale-50 pointer-events-none' directly to the base class so it starts hidden before Angular loads -->
            <div class="bg-[var(--background)] w-80 sm:w-[400px] rounded-2xl shadow-2xl border border-[var(--border)] flex flex-col mb-4 overflow-hidden transition-all duration-300 origin-bottom-right opacity-0 scale-50 pointer-events-none"
                 ng-class="chatOpen ? 'opacity-100 scale-100 pointer-events-auto' : 'opacity-0 scale-50 pointer-events-none'"
                 style="height: 600px; max-height: 75vh;">

                <!-- Header -->
                <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--border)] bg-[var(--background)] z-10">
                    <div>
                        <h1 class="text-[var(--foreground)] font-semibold text-sm">GreenBot</h1>
                        <p class="text-[var(--muted-foreground)] text-xs">AI Data Assistant</p>
                    </div>
                    <button ng-click="clearChat()" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-[var(--border)] text-[var(--muted-foreground)] hover:text-[var(--foreground)] hover:bg-[var(--accent)] text-xs transition-all focus:outline-none focus:ring-2 focus:ring-[var(--primary)]">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18" /><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" /><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" /></svg>
                        Clear
                    </button>
                </div>

                <!-- Quick Suggestions -->
                <div class="px-5 py-3 border-b border-[var(--border)] bg-[var(--muted)]">
                    <p class="text-[11px] text-[var(--muted-foreground)] mb-2 uppercase font-semibold tracking-wider">Quick queries</p>
                    <div class="flex flex-wrap gap-2">
                        <button ng-repeat="suggestion in renterSuggestions"
                                ng-click="sendMessageGuest(suggestion)"
                                class="text-xs px-3 py-1.5 bg-[var(--background)] text-[var(--foreground)] rounded-full border border-[var(--border)] hover:bg-[var(--accent)] transition-colors">
                            <span ng-bind="suggestion"></span>
                        </button>
                    </div>
                </div>

                <!-- Messages Area -->
                <div id="chat-scroll-area" class="flex-1 overflow-y-auto p-5 space-y-4 bg-[var(--background)]">
                    <div ng-repeat="msg in chatMessages" class="flex gap-3" ng-class="msg.sender === 'user' ? 'justify-end' : 'justify-start'">

                        <!-- Bot Avatar -->
                        <div ng-show="msg.sender === 'bot'" class="w-8 h-8 bg-[var(--accent)] rounded-full flex items-center justify-center flex-shrink-0 mt-0.5" ng-cloak>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--primary)]"><rect x="3" y="11" width="18" height="10" rx="2" /><circle cx="12" cy="5" r="2" /><path d="M12 7v4" /><line x1="8" y1="16" x2="8" y2="16" /><line x1="16" y1="16" x2="16" y2="16" /></svg>
                        </div>

                        <!-- Message Bubble -->
                        <div class="max-w-[75%] rounded-2xl px-4 py-3 text-sm"
                             ng-class="msg.sender === 'user' ? 'bg-[var(--primary)] text-[var(--primary-foreground)] rounded-br-sm' : 'bg-[var(--muted)] text-[var(--foreground)] border border-[var(--border)] rounded-bl-sm'">
                            <span ng-bind="msg.text"></span>
                            <div class="text-[10px] mt-1 opacity-70" ng-class="msg.sender === 'user' ? 'text-[var(--primary-foreground)]' : 'text-[var(--muted-foreground)]'">
                                <span ng-bind="msg.time | date:'shortTime'"></span>
                            </div>
                        </div>

                        <!-- User Avatar -->
                        <div ng-show="msg.sender === 'user'" class="w-8 h-8 bg-[var(--accent)] rounded-full flex items-center justify-center flex-shrink-0 mt-0.5" ng-cloak>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--primary)]"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        </div>
                    </div>

                    <!-- Typing Indicator -->
                    <div ng-show="isBotTyping" class="flex gap-3 items-start" ng-cloak>
                        <div class="w-8 h-8 bg-[var(--accent)] rounded-full flex items-center justify-center flex-shrink-0">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--primary)]"><rect x="3" y="11" width="18" height="10" rx="2" /><circle cx="12" cy="5" r="2" /><path d="M12 7v4" /></svg>
                        </div>
                        <div class="bg-[var(--muted)] border border-[var(--border)] rounded-2xl rounded-bl-sm px-4 py-4 flex gap-1 items-center">
                            <span class="w-1.5 h-1.5 bg-[var(--muted-foreground)] rounded-full animate-bounce" style="animation-delay: 0ms"></span>
                            <span class="w-1.5 h-1.5 bg-[var(--muted-foreground)] rounded-full animate-bounce" style="animation-delay: 150ms"></span>
                            <span class="w-1.5 h-1.5 bg-[var(--muted-foreground)] rounded-full animate-bounce" style="animation-delay: 300ms"></span>
                        </div>
                    </div>
                </div>

                <!-- Input Area -->
                <div class="p-4 border-t border-[var(--border)] bg-[var(--background)]">
                    <form ng-submit="sendMessageGuest()" class="flex gap-2">
                        <input type="text" ng-model="userMessage" placeholder="Ask about your rental data..."
                               class="flex-1 px-4 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--input-background)] text-[var(--foreground)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--primary)]" />
                        <button type="submit" ng-disabled="!userMessage"
                                class="px-4 py-2.5 bg-[var(--primary)] hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed text-[var(--primary-foreground)] rounded-xl transition-all focus:outline-none focus:ring-2 focus:ring-[var(--primary)]">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Floating Chat Toggle Button -->
            <!-- FIX: Added default bg/text colors to standard class so it doesn't render gray for a split second -->
            <button ng-click="chatOpen = !chatOpen; unread = 0"
                    class="w-14 h-14 rounded-full shadow-xl flex items-center justify-center transition-all duration-300 focus:outline-none hover:scale-105 active:scale-95 relative pointer-events-auto bg-[var(--primary)] text-[var(--primary-foreground)]"
                    ng-class="chatOpen ? 'bg-[var(--muted)] text-[var(--foreground)] border border-[var(--border)]' : 'bg-[var(--primary)] text-[var(--primary-foreground)] hover:opacity-90'">

                <!-- Unread Badge -->
                <span ng-show="!chatOpen && unread > 0" class="absolute -top-1 -right-1 w-5 h-5 bg-[var(--destructive)] text-[var(--destructive-foreground)] text-[10px] font-bold rounded-full flex items-center justify-center shadow-sm z-10 border-2 border-[var(--background)]" ng-cloak>
                    {{unread}}
                </span>

                <!-- Bot Icon (Shows when closed) -->
                <svg ng-show="!chatOpen" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" ng-cloak><rect x="3" y="11" width="18" height="10" rx="2" /><circle cx="12" cy="5" r="2" /><path d="M12 7v4" /><line x1="8" y1="16" x2="8" y2="16" /><line x1="16" y1="16" x2="16" y2="16" /></svg>

                <!-- Close Icon (Shows when open) -->
                <svg ng-show="chatOpen" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" ng-cloak><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
            </button>
        </div>

    </div><!-- Floating GreenBot Widget -->

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/Scripts/Module.js"></script>
    <script src="~/Scripts/Scripts/InputRules.js?v=20261028-input-rules"></script>
    <script src="~/Scripts/Scripts/Service.js"></script>
    <script src="~/Scripts/Scripts/Controller.js?v=20261028-input-rules"></script>
    <script src="~/Scripts/Chart.min.js"></script>
    <script src="~/Scripts/angular-chart.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</body>
</html>
