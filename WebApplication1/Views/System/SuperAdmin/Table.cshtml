@{
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}

<div class="p-4 sm:p-6 space-y-6"
     ng-init="initLookup(); currentPage = 'table';"
     ng-cloak>

    <!-- Header -->
    <div>
        <h1 class="text-slate-900 text-xl font-semibold">
            Amenities
        </h1>

        <p ng-if="!isLoading"
           class="text-slate-500 text-sm">
            Manage the amenities available across the platform.
        </p>

        <div ng-if="isLoading"
             class="h-4 w-72 bg-slate-200 rounded animate-pulse mt-1">
        </div>
    </div>


    <!-- Info banner -->
    <div class="flex items-start gap-3 bg-green-50 border border-green-100 rounded-2xl px-4 py-3">

        <svg width="16"
             height="16"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             class="text-green-600 shrink-0 mt-0.5">

            <ellipse cx="12" cy="5" rx="9" ry="3" />

            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />

            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
        </svg>

        <p class="text-sm text-green-800">
            Changes here apply platform-wide instantly. Removing an amenity does not affect existing records that already reference it.
        </p>
    </div>


    <!-- Card -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">

        <!-- Card header -->
        <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">

            <p ng-if="!isLoading"
               class="text-sm font-semibold text-slate-900">
                Amenities
            </p>

            <p ng-if="!isLoading"
               class="text-xs text-slate-400">
                {{ amenities.length || 0 }} total
            </p>


            <div ng-if="isLoading"
                 class="h-4 w-28 bg-slate-200 rounded animate-pulse">
            </div>

            <div ng-if="isLoading"
                 class="h-3 w-20 bg-slate-200 rounded animate-pulse">
            </div>

        </div>


        <!-- Skeleton -->
        <div ng-if="isLoading"
             class="p-5 animate-pulse">

            <div class="flex flex-wrap gap-2 mb-4">

                <div ng-repeat="i in [1,2,3,4,5,6]"
                     class="h-7 w-24 bg-slate-200 rounded-full">
                </div>

            </div>

            <div class="h-10 w-full max-w-sm bg-slate-200 rounded-xl">
            </div>

        </div>


        <!-- Loaded content -->
        <div ng-if="!isLoading"
             class="p-5">

            <!-- Amenities -->
            <div class="flex flex-wrap gap-2 mb-4">

                <span ng-repeat="item in amenities"
                      class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-slate-200 text-sm text-slate-700 shadow-sm">

                    {{ item.name }}

                    <button type="button"
                            ng-click="removeItem(item)"
                            ng-disabled="deletingAmenityId === item.id"
                            class="text-slate-400 hover:text-red-500 disabled:opacity-40 disabled:cursor-not-allowed transition-colors focus:outline-none"
                            title="Remove amenity">

                        <!-- Remove spinner -->
                        <svg ng-if="deletingAmenityId === item.id"
                             class="animate-spin"
                             width="12"
                             height="12"
                             viewBox="0 0 24 24"
                             fill="none">

                            <circle cx="12"
                                    cy="12"
                                    r="9"
                                    stroke="currentColor"
                                    stroke-width="3"
                                    opacity="0.25">
                            </circle>

                            <path d="M21 12a9 9 0 0 0-9-9"
                                  stroke="currentColor"
                                  stroke-width="3"
                                  stroke-linecap="round">
                            </path>

                        </svg>


                        <!-- X icon -->
                        <svg ng-if="deletingAmenityId !== item.id"
                             width="12"
                             height="12"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <line x1="18"
                                  y1="6"
                                  x2="6"
                                  y2="18" />

                            <line x1="6"
                                  y1="6"
                                  x2="18"
                                  y2="18" />

                        </svg>

                    </button>

                </span>


                <p ng-show="amenities.length === 0"
                   class="text-sm text-slate-400 italic">

                    No amenities yet — add one below.

                </p>

            </div>


            <!-- Add amenity -->
            <form class="flex gap-2 max-w-sm"
                  ng-submit="addAmenity()"
                  novalidate>

                <input type="text"
                       ng-model="amenityForm.name"
                       name="amenityName"
                       ng-disabled="addingAmenity"
                       input-rule="code" input-rule-label="Amenity name" input-rule-required input-rule-max="100"
                       placeholder="Type an amenity and press Enter…"
                       class="flex-1 px-3 py-2 text-sm border border-slate-200 rounded-xl bg-white disabled:bg-slate-50 disabled:text-slate-400 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all" />


                <button type="submit"
                        ng-disabled="addingAmenity"
                        class="min-w-[82px] flex items-center justify-center gap-1.5 px-4 py-2 bg-green-600 hover:bg-green-700 disabled:opacity-60 disabled:cursor-not-allowed text-white text-sm font-medium rounded-xl transition-all focus:outline-none">

                    <!-- Loading spinner -->
                    <svg ng-if="addingAmenity"
                         class="animate-spin"
                         width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none">

                        <circle cx="12"
                                cy="12"
                                r="9"
                                stroke="currentColor"
                                stroke-width="3"
                                opacity="0.25">
                        </circle>

                        <path d="M21 12a9 9 0 0 0-9-9"
                              stroke="currentColor"
                              stroke-width="3"
                              stroke-linecap="round">
                        </path>

                    </svg>


                    <!-- Plus icon -->
                    <svg ng-if="!addingAmenity"
                         width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <line x1="12"
                              y1="5"
                              x2="12"
                              y2="19" />

                        <line x1="5"
                              y1="12"
                              x2="19"
                              y2="12" />

                    </svg>


                    {{ addingAmenity ? 'Adding…' : 'Add' }}

                </button>

            </form>

        </div>

    </div>

</div>
