@{
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}
<div class="p-4 sm:p-6 space-y-6" ng-init="initDashboard(); currentPage = 'dashboard';" ng-cloak>
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-slate-900 text-xl font-semibold">Dashboard</h1>
            <p ng-if="!isLoading" class="text-slate-500 text-sm">
                System overview — GreenRent administration
            </p>
            <div ng-if="isLoading" class="h-4 w-64 bg-slate-200 rounded animate-pulse mt-1"></div>
        </div>
        <p class="text-slate-400 text-sm hidden sm:block">@DateTime.Now.ToString("MMMM yyyy")</p>
    </div>

    <div ng-if="isLoading" class="grid grid-cols-2 gap-4 animate-pulse">
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
            <div class="w-10 h-10 rounded-xl bg-slate-200 mb-3"></div>
            <div class="h-3 w-20 bg-slate-200 rounded mb-2"></div>
            <div class="h-8 w-16 bg-slate-200 rounded mb-2"></div>
            <div class="h-3 w-32 bg-slate-200 rounded"></div>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
            <div class="w-10 h-10 rounded-xl bg-slate-200 mb-3"></div>
            <div class="h-3 w-24 bg-slate-200 rounded mb-2"></div>
            <div class="h-8 w-16 bg-slate-200 rounded mb-2"></div>
            <div class="h-3 w-32 bg-slate-200 rounded"></div>
        </div>
    </div>

    <div ng-if="!isLoading" class="grid grid-cols-2 gap-4">
        <div ng-click="goTo('AdminManagers')"
             class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm transition-all transform hover:-translate-y-0.5 cursor-pointer hover:shadow-md">
            <div class="flex items-start justify-between mb-3">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center bg-green-50">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-green-600">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </div>
            </div>
            <p class="text-slate-500 text-xs mb-1">Active Users</p>
            <p class="text-2xl font-bold text-slate-900">{{ activeManagers }}</p>
            <p class="text-slate-400 text-xs mt-1">{{ lockedManagers }} offline &middot; {{ totalAccounts }} total</p>
        </div>

        <div ng-click="goTo('AdminLogs')"
             class="bg-white rounded-2xl p-5 border border-red-100 shadow-sm transition-all transform hover:-translate-y-0.5 cursor-pointer hover:shadow-md">
            <div class="flex items-start justify-between mb-3">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center bg-red-50">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-red-500">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                </div>
            </div>
            <p class="text-slate-500 text-xs mb-1">Security Alerts</p>
            <p class="text-2xl font-bold text-red-600">{{criticalAlerts + warningAlerts || 0}}</p>
            <p class="text-slate-400 text-xs mt-1">{{criticalAlerts  || 0}} Critical &middot; {{ warningAlerts || 0}} Warning</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-slate-900 font-medium">Managers Account</h3>
                <button ng-click="goTo('AdminManagers')" class="text-green-600 text-xs flex items-center gap-1 hover:text-green-700 transition-colors">
                    Manage
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7" /><polyline points="7 7 17 7 17 17" /></svg>
                </button>
            </div>
            <div ng-if="isLoading" class="space-y-3 animate-pulse">
                <div ng-repeat="i in [1, 2, 3, 4, 5]" class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-slate-200 shrink-0"></div>
                    <div class="flex-1 min-w-0 space-y-1.5">
                        <div class="h-3 w-1/3 bg-slate-200 rounded"></div>
                        <div class="h-2 w-1/2 bg-slate-200 rounded"></div>
                    </div>
                    <div class="h-5 w-16 bg-slate-200 rounded-full shrink-0"></div>
                </div>
            </div>
            <div ng-if="!isLoading" class="space-y-3">
                <div ng-repeat="m in propertyManagers | limitTo: 10" class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-700 text-xs font-bold shrink-0">
                        {{ getInitials(m.name) }}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm text-slate-900 font-medium truncate">{{ m.name }}</p>
                        <p class="text-xs text-slate-400 truncate">{{ m.email }}</p>
                    </div>
                    <span class="shrink-0 inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium"
                          ng-class="m.status === 'active' ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500'">
                        <span class="w-1.5 h-1.5 rounded-full" ng-class="m.status === 'active' ? 'bg-emerald-500' : 'bg-slate-400'"></span>
                        {{ m.status === 'active' ? 'Online' : 'Offline' }}
                    </span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100">
                <h3 class="text-slate-900 font-medium">Recent Activity</h3>
                <button ng-click="goTo('AdminLogs')" class="text-green-600 text-xs flex items-center gap-1 hover:text-green-700 transition-colors">
                    View all
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7" /><polyline points="7 7 17 7 17 17" /></svg>
                </button>
            </div>
            <div class="divide-y divide-slate-50">
                <div ng-if="isLoading" class="animate-pulse">
                    <div ng-repeat="i in [1, 2, 3, 4, 5]" class="flex items-start gap-3 px-5 py-3">
                        <div class="w-7 h-7 rounded-lg bg-slate-200 shrink-0 mt-0.5"></div>
                        <div class="flex-1 min-w-0 space-y-1.5 mt-1">
                            <div class="h-3 w-3/4 bg-slate-200 rounded"></div>
                            <div class="h-2 w-1/3 bg-slate-200 rounded"></div>
                        </div>
                    </div>
                </div>

                <div ng-if="!isLoading" ng-repeat="entry in recentActivity | limitTo: 10" class="flex items-start gap-3 px-5 py-3">
                    <div class="w-7 h-7 rounded-lg flex items-center justify-center shrink-0 mt-0.5" ng-class="getAuditColor(entry.type)">
                        <svg ng-if="entry.type === 'login'" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" y1="12" x2="3" y2="12" /></svg>

                        <svg ng-if="entry.type === 'settings'" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>

                        <svg ng-if="entry.type === 'security'" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>

                        <svg ng-if="entry.type === 'user'" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><line x1="20" y1="8" x2="20" y2="14" /><line x1="23" y1="11" x2="17" y2="11" /></svg>
                    </div>

                    <div class="flex-1 min-w-0">
                        <p class="text-xs text-slate-700 leading-snug">{{ entry.message }}</p>
                        <p class="text-[11px] text-slate-400 mt-0.5">
                            {{ entry.actor }} &middot; {{ entry.time }}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
