@{
    Layout = "~/Views/Shared/_RentersLayout.cshtml";
}

<!-- Initialize loading state immediately alongside the API call -->
<div class="min-h-screen bg-slate-50" ng-init="isLoading = true; getAllBrowseUnits(); currentPage = 'Browse';">

    <!-- Banner -->
    <div ng-if="!browseBanner.dismissed" class="bg-gradient-to-r from-green-600 to-green-700 overflow-hidden transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between gap-4">
            <p class="text-white text-sm">
                🏠 <strong>Welcome!</strong> All listed units are vacant and ready to book. Sign-up required.
            </p>
            <button type="button" ng-click="dismissBrowseBanner()" class="text-white/70 hover:text-white transition-colors flex-shrink-0 focus:outline-none focus:ring-2 focus:ring-white/50 rounded" aria-label="Dismiss banner">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6 6 18" />
                    <path d="m6 6 12 12" />
                </svg>
            </button>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- Header -->
        <div class="mb-6">
            <h1 class="text-slate-900 mb-1 text-2xl font-bold">Browse Units</h1>
            <p class="text-slate-500 text-sm" ng-if="!isLoading">
                {{ browseCount }} vacant unit{{ browseCount !== 1 ? "s" : "" }} available to book
            </p>
            <div ng-if="isLoading" class="h-4 w-48 bg-slate-200 animate-pulse rounded mt-1"></div>
        </div>

        <!-- Search and Filters Top Bar -->
        <div class="flex gap-3 mb-4 flex-wrap">
            <div class="relative flex-1 min-w-64">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.3-4.3" />
                </svg>

                <input type="text" ng-model="browseQuery" ng-model-options="{ debounce: 300 }" placeholder="Search by name, area, amenity..." class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-green-500 transition-all" aria-label="Search units" />

                <button ng-if="browseQuery" ng-click="clearQuery()" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 6 6 18" />
                        <path d="m6 6 12 12" />
                    </svg>
                </button>
            </div>

            <button ng-click="browseShowFilters = !browseShowFilters" ng-class="{'bg-green-600 text-white border-green-600': browseShowFilters || activeFilterCount() > 0, 'bg-white text-slate-700 border-slate-200 hover:border-slate-300': !browseShowFilters && activeFilterCount() === 0}" class="flex items-center gap-2 px-4 py-2.5 rounded-xl border text-sm transition-all focus:outline-none focus:ring-2 focus:ring-green-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="21" x2="14" y1="4" y2="4" />
                    <line x1="10" x2="3" y1="4" y2="4" />
                    <line x1="21" x2="12" y1="12" y2="12" />
                    <line x1="8" x2="3" y1="12" y2="12" />
                    <line x1="21" x2="16" y1="20" y2="20" />
                    <line x1="12" x2="3" y1="20" y2="20" />
                    <line x1="14" x2="14" y1="2" y2="6" />
                    <line x1="8" x2="8" y1="10" y2="14" />
                    <line x1="16" x2="16" y1="18" y2="22" />
                </svg>
                Filters

                <span ng-if="activeFilterCount() > 0" class="w-5 h-5 rounded-full bg-white text-green-600 text-xs flex items-center justify-center font-semibold">
                    {{ activeFilterCount() }}
                </span>

                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform" ng-class="{'rotate-180': browseShowFilters}">
                    <path d="m6 9 6 6 6-6" />
                </svg>
            </button>

            <button ng-if="activeFilterCount() > 0 || browseQuery" ng-click="clearAllBrowse()" class="px-3 py-2.5 rounded-xl text-sm text-slate-500 hover:text-slate-700 hover:bg-white border border-slate-200 transition-all">
                Clear all
            </button>
        </div>

        <!-- Filters Dropdown Panel -->
        <div ng-show="browseShowFilters" class="overflow-hidden mb-4 transition-all duration-300">
            <div class="bg-white border border-slate-200 rounded-2xl p-5 space-y-5">

                <div>
                    <p class="text-sm text-slate-700 font-medium mb-2">Unit Type</p>
                    <div class="flex flex-wrap gap-2">
                        <button ng-repeat="bed in BED_OPTIONS" ng-click="toggleBed(bed)" ng-class="{'bg-green-600 text-white border-green-600': isBedSelected(bed), 'bg-slate-50 text-slate-700 border-slate-200 hover:border-green-300': !isBedSelected(bed)}" class="px-3 py-1.5 rounded-full text-sm border transition-all focus:outline-none focus:ring-2 focus:ring-green-500">
                            {{ bed }}
                        </button>
                    </div>
                </div>

                <div>
                    <p class="text-sm text-slate-700 font-medium mb-2">Rent Type</p>
                    <div class="flex flex-wrap gap-2">
                        <button ng-repeat="rent in RENT_OPTIONS" ng-click="toggleRent(rent)" ng-class="{'bg-green-600 text-white border-green-600' : isRentTypeSelected(rent), 'bg-slate-50 text-slate-700 border-slate-200 hover:border-green-300' : !isRentTypeSelected(rent)}" class="px-3 py-1.5 rounded-full text-sm border transition-all focus:outline-none focus:ring-2 focus:ring-green-500">
                            {{rent}}
                        </button>
                    </div>
                </div>

                <div>
                    <p class="text-sm text-slate-700 font-medium mb-2">Price Range (₱/mo)</p>
                    <div class="flex gap-3 items-center">
                        <input type="text" inputmode="decimal" ng-model="browsePriceMin" ng-model-options="{ debounce: 300 }" placeholder="Min"
                               input-rule="decimal" input-rule-label="Minimum price" input-rule-min="0" input-rule-max="999999.99" class="w-28 px-3 py-2 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" />
                        <span class="text-slate-400">—</span>
                        <input type="text" inputmode="decimal" ng-model="browsePriceMax" ng-model-options="{ debounce: 300 }" placeholder="Max"
                               input-rule="decimal" input-rule-label="Maximum price" input-rule-min="0" input-rule-max="999999.99" class="w-28 px-3 py-2 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" />
                    </div>
                </div>

                <div>
                    <p class="text-sm text-slate-700 font-medium mb-2">Amenities</p>
                    <div class="flex flex-wrap gap-2">
                        <button ng-repeat="a in AMENITY_OPTIONS" ng-click="toggleAmenity(a)" ng-class="{'bg-green-600 text-white border-green-600': isAmenitySelected(a), 'bg-slate-50 text-slate-700 border-slate-200 hover:border-green-300': !isAmenitySelected(a)}" class="px-3 py-1.5 rounded-full text-sm border transition-all focus:outline-none focus:ring-2 focus:ring-green-500">
                            {{ a }}
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- State: SKELETON LOADER (Shows only when isLoading is true) -->
        <div ng-if="isLoading" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
            <!-- Repeats 8 skeleton placeholder cards -->
            <div ng-repeat="i in [1,2,3,4,5,6,7,8]" class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
                <div class="h-44 bg-slate-200 animate-pulse"></div>
                <div class="p-4 space-y-4">
                    <div class="flex justify-between items-center">
                        <div class="h-5 bg-slate-200 rounded animate-pulse w-1/2"></div>
                        <div class="h-5 bg-slate-200 rounded animate-pulse w-1/4"></div>
                    </div>
                    <div class="h-3 bg-slate-200 rounded animate-pulse w-3/4"></div>
                    <div class="space-y-2">
                        <div class="h-3 bg-slate-200 rounded animate-pulse w-full"></div>
                        <div class="h-3 bg-slate-200 rounded animate-pulse w-5/6"></div>
                    </div>
                    <div class="flex gap-2">
                        <div class="h-5 w-16 bg-slate-200 rounded-full animate-pulse"></div>
                        <div class="h-5 w-20 bg-slate-200 rounded-full animate-pulse"></div>
                        <div class="h-5 w-14 bg-slate-200 rounded-full animate-pulse"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- State: EMPTY/NO RESULTS (Shows when not loading AND no data exists) -->
        <div ng-if="!isLoading && browseCount === 0 && browseUnits.length > 0" class="text-center py-20">
            <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400">
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.3-4.3" />
                </svg>
            </div>
            <h3 class="text-slate-700 mb-2 font-semibold">No units found</h3>
            <p class="text-slate-400 text-sm mb-4">Try adjusting your filters or search terms</p>
            <button ng-click="clearAllBrowse()" class="px-4 py-2 bg-green-600 text-white rounded-xl text-sm hover:bg-green-700 transition-all">
                Clear filters
            </button>
        </div>

        <!-- State: ACTUAL DATA GRID (Shows only when loading is complete) -->
        <div ng-if="!isLoading" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
            <div ng-repeat="unit in filteredBrowse()" ng-click="goToUnit(unit.id)"
                 class="group bg-white rounded-2xl border border-slate-200 overflow-hidden cursor-pointer hover:shadow-lg hover:-translate-y-0.5 transition-all">

                <div class="relative h-44 bg-slate-100 overflow-hidden">
                    <img ng-if="unit.images.length > 0"
                         ng-src="{{ unit.images[0] }}"
                         alt="{{ unit.name }}"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />

                    <div ng-if="unit.images.length === 0" class="w-full h-full flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300">
                            <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                            <circle cx="9" cy="9" r="2" />
                            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                        </svg>
                    </div>

                    <!-- Bedspace indicator -->
                    <span ng-if="unit.joinable"
                          class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                        Bedspace
                    </span>

                    <!-- Vacant indicator -->
                    <span ng-if="!unit.joinable"
                          class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-100">
                        Vacant
                    </span>


                    <span class="absolute top-3 right-3 w-3 h-3 rounded-full ring-2 ring-white"
                          ng-style="{ 'background-color': unit.colorCode || '#94A3B8' }"></span>
                </div>

                <div class="p-4">
                    <div class="flex items-start justify-between gap-2 mb-1">
                        <h3 class="text-slate-900 font-medium truncate">{{ unit.name }}</h3>
                        <p class="text-green-700 font-semibold whitespace-nowrap">
                            &#8369;{{ unit.price | number:0 }}
                        </p>
                    </div>

                    <p class="text-slate-400 text-xs mb-3">
                        {{ unit.beds }} &middot; {{ unit.sqm }} sqm &middot; Floor {{ unit.floor }}
                    </p>

                    <p class="text-slate-500 text-sm mb-3" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                        {{ unit.description }}
                    </p>

                    <div class="flex flex-wrap gap-1.5">
                        <span ng-repeat="am in unit.amenities | limitTo:3"
                              class="px-2 py-0.5 rounded-full bg-slate-50 text-slate-600 text-xs border border-slate-200">
                            {{ am }}
                        </span>
                        <span ng-if="unit.amenities.length > 3"
                              class="px-2 py-0.5 rounded-full bg-slate-50 text-slate-400 text-xs border border-slate-200">
                            +{{ unit.amenities.length - 3 }}
                        </span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
