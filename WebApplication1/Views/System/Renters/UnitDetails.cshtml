@{
    Layout = "~/Views/Shared/_RentersLayout.cshtml";
}

<div class="min-h-screen bg-slate-50" ng-init="getUnitDetail(); bkCheckVisitor()">

    <!-- ============ BACK NAV ============ -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <button ng-click="backToBrowse()" class="flex items-center gap-1.5 text-slate-600 hover:text-slate-900 text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-green-500 rounded-lg px-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 19-7-7 7-7" />
                <path d="M19 12H5" />
            </svg>
            Back to Browse
        </button>
    </div>

    <!-- ============ LOADING SKELETON ============ -->
    <div ng-if="unitDetailLoading"
         class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16"
         role="status"
         aria-live="polite">
        <span class="sr-only">Loading unit details...</span>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-pulse" aria-hidden="true">
            <div class="lg:col-span-2 space-y-6">
                <div class="rounded-2xl bg-slate-200" style="aspect-ratio: 16/9;"></div>

                <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-5">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-1 space-y-3">
                            <div class="h-7 w-48 sm:w-64 bg-slate-200 rounded-lg"></div>
                            <div class="h-4 w-40 sm:w-56 bg-slate-200 rounded"></div>
                        </div>
                        <div class="h-9 w-24 bg-slate-200 rounded-xl"></div>
                    </div>

                    <div class="flex flex-wrap gap-5 py-4 border-y border-slate-100">
                        <div ng-repeat="i in [1,2,3,4]" class="flex items-center gap-2">
                            <div class="h-5 w-5 bg-slate-200 rounded"></div>
                            <div class="h-4 w-20 bg-slate-200 rounded"></div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <div class="h-3.5 w-full bg-slate-200 rounded"></div>
                        <div class="h-3.5 w-11/12 bg-slate-200 rounded"></div>
                        <div class="h-3.5 w-3/4 bg-slate-200 rounded"></div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
                    <div class="p-6 space-y-3">
                        <div class="h-5 w-44 bg-slate-200 rounded"></div>
                        <div class="h-3.5 w-64 max-w-full bg-slate-200 rounded"></div>
                    </div>
                    <div class="mx-6 mb-6 h-44 bg-slate-200 rounded-xl"></div>
                </div>

                <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
                    <div class="h-5 w-28 bg-slate-200 rounded mb-5"></div>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                        <div ng-repeat="i in [1,2,3,4,5,6]" class="flex items-center gap-2">
                            <div class="h-8 w-8 bg-slate-200 rounded-lg"></div>
                            <div class="h-4 w-20 bg-slate-200 rounded"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-1">
                <div class="sticky top-24 bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-5">
                    <div class="space-y-2">
                        <div class="h-8 w-44 bg-slate-200 rounded-lg"></div>
                        <div class="h-4 w-28 bg-slate-200 rounded"></div>
                    </div>

                    <div class="space-y-4 py-5 border-y border-slate-100">
                        <div ng-repeat="i in [1,2,3]" class="flex justify-between gap-4">
                            <div class="h-4 w-28 bg-slate-200 rounded"></div>
                            <div class="h-4 w-20 bg-slate-200 rounded"></div>
                        </div>
                    </div>

                    <div class="h-12 w-full bg-slate-200 rounded-xl"></div>
                    <div class="h-16 w-full bg-slate-100 rounded-xl"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ NOT FOUND ============ -->
    <div ng-if="!unitDetailLoading && !currentUnit" class="min-h-96 flex items-center justify-center">
        <div class="text-center">
            <h2 class="text-slate-700 mb-2 font-semibold">Unit not found</h2>
            <button ng-click="backToBrowse()" class="text-green-600 hover:underline text-sm">&larr; Back to Browse</button>
        </div>
    </div>

    <div ng-if="!unitDetailLoading && currentUnit" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- ============ LEFT / MAIN ============ -->
            <div class="lg:col-span-2 space-y-6">

                <!-- Slideshow -->
                <div class="relative rounded-2xl overflow-hidden bg-slate-200" style="aspect-ratio: 16/9;">
                    <img ng-if="currentUnit.images.length > 0"
                         ng-src="{{ currentUnit.images[slideIndex] }}"
                         alt="{{ currentUnit.name }}"
                         class="w-full h-full object-cover" />

                    <div ng-if="currentUnit.images.length === 0" class="w-full h-full"
                         ng-style="{ 'background-color': currentUnit.color || '#94A3B8' }"></div>

                    <button ng-show="currentUnit.images.length > 1"
                            ng-click="slideIndex = (slideIndex - 1 + currentUnit.images.length) % currentUnit.images.length"
                            class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 bg-white/80 hover:bg-white rounded-full flex items-center justify-center shadow transition-all"
                            aria-label="Previous image">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m15 18-6-6 6-6" />
                        </svg>
                    </button>

                    <button ng-show="currentUnit.images.length > 1"
                            ng-click="slideIndex = (slideIndex + 1) % currentUnit.images.length"
                            class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 bg-white/80 hover:bg-white rounded-full flex items-center justify-center shadow transition-all"
                            aria-label="Next image">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                    </button>

                    <div ng-if="currentUnit.images.length > 1" class="absolute bottom-3 left-0 right-0 flex justify-center gap-1.5">
                        <button ng-repeat="img in currentUnit.images track by $index"
                                ng-click="setSlide($index)"
                                ng-class="{'bg-white w-6': slideIndex === $index, 'bg-white/50 w-2': slideIndex !== $index}"
                                class="h-2 rounded-full transition-all"
                                aria-label="Go to image {{ $index + 1 }}"></button>
                    </div>
                </div>

                <!-- Header -->
                <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
                    <div class="flex items-start justify-between gap-4 mb-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-1">
                                <h1 class="text-slate-900 text-2xl font-bold">{{ currentUnit.name }}</h1>
                                <span class="text-xs px-2.5 py-1 rounded-full font-medium" ng-class="getOccupancyClass(unitOccupancy)">
                                    {{ unitOccupancy }}
                                </span>
                            </div>
                            <div ng-if="currentUnit.address" class="flex items-center gap-1 text-slate-500 text-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                                    <circle cx="12" cy="10" r="3" />
                                </svg>
                                {{ currentUnit.address }}
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <button type="button" ng-click="copyUnitLink()"
                                    class="flex items-center gap-1.5 px-3 py-2 rounded-xl border border-slate-200 text-slate-500 hover:border-green-300 hover:text-green-700 transition-all focus:outline-none focus:ring-2 focus:ring-green-500"
                                    aria-label="Copy unit link" title="Copy unit link">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                                </svg>
                                <span class="hidden sm:inline text-sm font-medium">Copy link</span>
                            </button>
                        </div>
                    </div>

                    <!-- Specs -->
                    <div class="flex flex-wrap gap-4 py-4 border-y border-slate-100 mb-4">
                        <div class="flex items-center gap-2 text-slate-700 text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600">
                                <path d="M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8" />
                                <path d="M4 10V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4" />
                                <path d="M12 4v6" />
                                <path d="M2 18h20" />
                            </svg>
                            <span>{{ currentUnit.beds }}</span>
                        </div>

                        <div class="flex items-center gap-2 text-slate-700 text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600">
                                <path d="M15 3h6v6" />
                                <path d="M9 21H3v-6" />
                                <path d="M21 3l-7 7" />
                                <path d="M3 21l7-7" />
                            </svg>
                            <span>{{ currentUnit.sqm }} m&sup2;</span>
                        </div>

                        <div class="flex items-center gap-2 text-slate-700 text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600">
                                <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
                                <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
                                <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
                            </svg>
                            <span>Floor {{ currentUnit.floor }}</span>
                        </div>

                        <div ng-if="currentUnit.maxOccupants" class="flex items-center gap-2 text-slate-700 text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                            </svg>
                            <span>Up to {{ currentUnit.maxOccupants }} {{ currentUnit.maxOccupants === 1 ? 'person' : 'people' }}</span>
                        </div>
                    </div>

                    <p class="text-slate-600 text-sm leading-relaxed">{{ currentUnit.description }}</p>
                </div>

                <!-- Showcase Video -->
                <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
                    <div class="flex items-center gap-3 px-6 pt-5 pb-3">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0"
                             ng-class="currentUnit.video ? 'bg-green-100' : 'bg-slate-100'">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 ng-class="currentUnit.video ? 'text-green-600' : 'text-slate-400'">
                                <rect width="18" height="18" x="3" y="3" rx="2" />
                                <path d="M7 3v18" />
                                <path d="M3 7.5h4" />
                                <path d="M3 12h18" />
                                <path d="M3 16.5h4" />
                                <path d="M17 3v18" />
                                <path d="M17 7.5h4" />
                                <path d="M17 16.5h4" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-slate-900 font-semibold">Unit Showcase Video</h3>
                            <p class="text-slate-400 text-xs">
                                {{ currentUnit.video ? 'Watch a walkthrough of this unit' : 'No walkthrough available yet' }}
                            </p>
                        </div>
                    </div>

                    <!-- Has a video -->
                    <div ng-if="currentUnit.video" class="relative bg-slate-900">
                        <video id="unitVideo"
                               ng-src="{{ currentUnit.video }}"
                               class="w-full max-h-80 object-contain"
                               controls
                               playsinline></video>
                    </div>

                    <!-- No video -->
                    <div ng-if="!currentUnit.video"
                         class="mx-6 mb-5 rounded-xl border-2 border-dashed border-slate-200 bg-slate-50 py-12 flex flex-col items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300 mb-2">
                            <path d="m16 16-4-4-4 4" />
                            <path d="M2 2l20 20" />
                            <path d="M10.66 5H14a2 2 0 0 1 2 2v3.34l1 1L22 8v8" />
                            <path d="M16 16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2" />
                        </svg>
                        <p class="text-slate-500 text-sm font-medium">No video for this unit</p>
                        <p class="text-slate-400 text-xs mt-0.5">Browse the photos above instead</p>
                    </div>

                    <div ng-if="currentUnit.video" class="px-6 py-4 bg-slate-50 border-t border-slate-100">
                        <p class="text-xs text-slate-500">
                            This video is provided for reference only and showcases the actual unit layout and finishes.
                        </p>
                    </div>
                </div>

                <!-- Amenities -->
                <div ng-if="currentUnit.amenities.length > 0" class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
                    <h3 class="text-slate-900 mb-4 font-semibold">Amenities</h3>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                        <div ng-repeat="a in currentUnit.amenities" class="flex items-center gap-2 text-slate-700 text-sm">
                            <div class="w-8 h-8 bg-green-50 rounded-lg flex items-center justify-center text-green-600 flex-shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                    <path d="m9 11 3 3L22 4" />
                                </svg>
                            </div>
                            {{ a }}
                        </div>
                    </div>
                </div>

                <!-- Similar Units -->
                <div ng-if="relatedUnits.length > 0" class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
                    <h3 class="text-slate-900 mb-4 font-semibold">Similar {{ currentUnit.beds }} Units</h3>
                    <div class="space-y-3">
                        <button ng-repeat="u in relatedUnits" ng-click="goToUnit(u.id)"
                                class="w-full flex items-center gap-4 p-3 rounded-xl hover:bg-slate-50 border border-slate-100 transition-all text-left focus:outline-none focus:ring-2 focus:ring-green-500">
                            <img ng-if="u.image" ng-src="{{ u.image }}" alt="{{ u.name }}" class="w-16 h-12 rounded-lg object-cover flex-shrink-0" />
                            <div ng-if="!u.image" class="w-16 h-12 rounded-lg flex-shrink-0" ng-style="{ 'background-color': u.color || '#94A3B8' }"></div>

                            <div class="flex-1 min-w-0">
                                <p class="text-slate-900 text-sm font-medium">{{ u.name }}</p>
                                <p class="text-slate-500 text-xs">{{ u.floor }} &middot; {{ u.sqm }}m&sup2;</p>
                            </div>
                            <p class="text-green-600 text-sm font-semibold flex-shrink-0">&#8369;{{ u.price | number:0 }}</p>
                        </button>
                    </div>
                </div>
            </div>

            <!-- ============ RIGHT / BOOKING PANEL ============ -->
            <div class="lg:col-span-1">
                <div class="sticky top-24">
                    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
                        <div class="mb-4">
                            <div class="flex items-baseline gap-1">
                                <span class="text-3xl text-slate-900" style="font-weight:700;">&#8369;{{ currentUnit.price | number:0 }}</span>
                                <span class="text-slate-500 text-sm">/month</span>
                            </div>
                            <p ng-if="isAvailable" class="text-emerald-600 text-sm mt-1 flex items-center gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                    <path d="m9 11 3 3L22 4" />
                                </svg>
                                {{ currentUnit.joinable ? currentUnit.slotsOpen + ' bedspace slot(s) available' : 'Available now' }}
                            </p>
                        </div>

                        <div class="space-y-3 mb-5 py-4 border-y border-slate-100">
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-500">Monthly Rent</span>
                                <span class="text-slate-900">&#8369;{{ currentUnit.price | number:0 }}</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-500">Security Deposit</span>
                                <span class="text-slate-900">&#8369;{{ currentUnit.price * 2 | number:0 }}</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-500">Advance Payment</span>
                                <span class="text-slate-900">&#8369;{{ currentUnit.price | number:0 }}</span>
                            </div>
                        </div>

                        <!-- Opens the modal. Pure scope flags, no controller call. -->
                        <button ng-click="openBooking()"
                                ng-disabled="!isAvailable"
                                ng-class="{'bg-green-600 hover:bg-green-700 text-white shadow-lg shadow-green-200': isAvailable, 'bg-slate-100 text-slate-400 cursor-not-allowed': !isAvailable}"
                                class="w-full flex items-center justify-center gap-2 py-3.5 rounded-xl text-sm font-medium transition-all focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="18" height="18" x="3" y="4" rx="2" />
                                <path d="M16 2v4" />
                                <path d="M8 2v4" />
                                <path d="M3 10h18" />
                            </svg>
                            {{ isAvailable ? 'Book a Viewing' : 'Currently Unavailable' }}
                        </button>

                        <p ng-if="!isAvailable" class="text-center text-slate-400 text-xs mt-3">
                            This unit currently has no available slots. Check back for availability.
                        </p>

                        <div class="mt-4 p-3 bg-slate-50 rounded-xl">
                            <p class="text-xs text-slate-500 text-center">
                                🔒 No payment required to book a viewing. Free site inspection.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>


    <!-- ============================================================
         BOOKING MODAL
         Step navigation is all inline. Only bkSendOtp / bkVerify /
         bkSubmit / bkSwitchAccount touch the server.
    ============================================================ -->
    <div ng-show="bookingOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4">

        <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" ng-click="bookingOpen = false"></div>

        <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">

            <div ng-show="bkStep !== 'success'" class="flex items-center justify-between px-6 py-4 border-b border-slate-100 sticky top-0 bg-white z-10">
                <h3 class="text-slate-900 font-semibold">
                    <span ng-if="bkStep === 'bedspace-confirm'">Confirm Bedspace Booking</span>
                    <span ng-if="bkStep === 'auth'">Sign Up to Book</span>
                    <span ng-if="bkStep === 'verify'">Verify Your Email</span>
                    <span ng-if="bkStep === 'confirm'">Review &amp; Submit</span>
                    <span ng-if="bkStep === 'calendar' || bkStep === 'slots' || bkStep === 'form'">Book a Viewing — {{ currentUnit.name }}</span>
                </h3>
                <button ng-click="bookingOpen = false" class="text-slate-400 hover:text-slate-600 transition-colors" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 6 6 18" />
                        <path d="m6 6 12 12" />
                    </svg>
                </button>
            </div>

            <!-- ============ BEDSPACE CONFIRMATION ============ -->
            <div ng-show="bkStep === 'bedspace-confirm'" class="p-6">
                <div class="w-14 h-14 bg-blue-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600">
                        <path d="M2 4v16" />
                        <path d="M2 8h18a2 2 0 0 1 2 2v10" />
                        <path d="M2 17h20" />
                        <path d="M6 8v9" />
                    </svg>
                </div>

                <h4 class="text-center text-slate-900 text-lg font-semibold mb-2">This is a bedspace unit</h4>
                <p class="text-center text-slate-500 text-sm leading-relaxed mb-5">
                    You are booking a viewing for <strong class="text-slate-800">one bedspace in {{ currentUnit.name }}</strong>,
                    not the entire unit. The unit is shared with other occupants.
                </p>

                <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 mb-6 space-y-2">
                    <div class="flex justify-between text-sm">
                        <span class="text-blue-700">Available bedspace slots</span>
                        <strong class="text-blue-900">{{ currentUnit.slotsOpen }}</strong>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-blue-700">Current occupants</span>
                        <strong class="text-blue-900">{{ currentUnit.currentOccupants }}</strong>
                    </div>
                </div>

                <p class="text-center text-slate-700 text-sm font-medium mb-5">
                    Do you want to continue booking this bedspace?
                </p>

                <div class="flex gap-3">
                    <button ng-click="bookingOpen = false"
                            class="flex-1 py-3 rounded-xl border border-slate-200 text-slate-600 text-sm font-medium hover:bg-slate-50 transition-all">
                        No, go back
                    </button>
                    <button ng-click="bkConfirmBedspace()"
                            class="flex-1 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition-all focus:outline-none focus:ring-2 focus:ring-blue-500">
                        Yes, continue
                    </button>
                </div>
            </div>

            <!-- ============ STEP 1 — AUTH ============ -->
            <div ng-show="bkStep === 'auth'" class="p-6">
                <p class="text-slate-500 text-sm mb-5">
                    Enter your details to continue booking
                    <span class="text-slate-800 font-medium">{{ currentUnit.name }}</span>.
                </p>

                <div class="space-y-4">

                    <div>
                        <label class="block text-sm text-slate-700 font-medium mb-1.5">Full Name *</label>
                        <div class="relative">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                            <input type="text" ng-model="bkName" placeholder="Your full name"
                                   input-rule="name" input-rule-label="Full name" input-rule-required
                                   ng-class="{'border-red-300 bg-red-50': bkErrors.name, 'border-slate-200 bg-slate-50': !bkErrors.name}"
                                   class="w-full pl-10 pr-4 py-2.5 rounded-xl border text-sm focus:outline-none focus:ring-2 focus:ring-green-500 transition-all" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm text-slate-700 font-medium mb-1.5">Email Address *</label>
                        <div class="relative">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                                <rect width="20" height="16" x="2" y="4" rx="2" />
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                            </svg>
                            <input type="text" ng-model="bkEmail" placeholder="you@example.com" inputmode="email"
                                   input-rule="email" input-rule-label="Email" input-rule-required
                                   ng-class="{'border-red-300 bg-red-50': bkErrors.email, 'border-slate-200 bg-slate-50': !bkErrors.email}"
                                   class="w-full pl-10 pr-4 py-2.5 rounded-xl border text-sm focus:outline-none focus:ring-2 focus:ring-green-500 transition-all" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm text-slate-700 font-medium mb-1.5">Phone / Contact *</label>
                        <div class="relative">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                            </svg>
                            <input type="text" ng-model="bkPhone" placeholder="09XXXXXXXXX" inputmode="numeric"
                                   input-rule="phone" input-rule-label="Phone number" input-rule-required
                                   ng-class="{'border-red-300 bg-red-50': bkErrors.phone, 'border-slate-200 bg-slate-50': !bkErrors.phone}"
                                   class="w-full pl-10 pr-4 py-2.5 rounded-xl border text-sm focus:outline-none focus:ring-2 focus:ring-green-500 transition-all" />
                        </div>
                    </div>

                    <!-- Terms & Conditions -->
                    <div>
                        <label class="block text-sm text-slate-700 font-medium mb-1.5">Terms &amp; Conditions</label>

                        <div class="h-36 overflow-y-auto rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs text-slate-500 leading-relaxed space-y-2">
                            <p class="font-semibold text-slate-700">Green Residences — Booking Terms &amp; Conditions</p>
                            <p><span class="font-medium text-slate-600">1. Purpose of Booking.</span> Submitting a viewing request through this platform does not constitute a binding lease agreement. It only reserves a scheduled slot for a unit viewing.</p>
                            <p><span class="font-medium text-slate-600">2. Accurate Information.</span> You agree to provide truthful and complete personal information (name, email, phone). Any misrepresentation may result in the cancellation of your booking without prior notice.</p>
                            <p><span class="font-medium text-slate-600">3. Scheduling Limits.</span> Each prospective renter is allowed a maximum of two (2) bookings per calendar month to ensure fair access for all applicants.</p>
                            <p><span class="font-medium text-slate-600">4. Cancellation Policy.</span> You may cancel your booking at any time before the scheduled viewing. Repeated no-shows or last-minute cancellations may result in a temporary suspension of booking privileges.</p>
                            <p><span class="font-medium text-slate-600">5. Identity Verification.</span> A one-time password (OTP) will be sent to your registered email address for identity verification. You must complete this step before proceeding with your booking.</p>
                            <p><span class="font-medium text-slate-600">6. Privacy &amp; Data Use.</span> Personal information collected during the booking process will only be used for scheduling and communication purposes. Green Residences will not sell or share your data with third parties without your consent.</p>
                            <p><span class="font-medium text-slate-600">7. Unit Availability.</span> Unit listings are subject to change. Green Residences reserves the right to modify or withdraw a unit from availability at any time without prior notice.</p>
                            <p><span class="font-medium text-slate-600">8. Code of Conduct.</span> All prospective renters are expected to behave respectfully during viewings. Any form of harassment toward staff or other residents is grounds for immediate removal from the premises and blacklisting from the platform.</p>
                            <p><span class="font-medium text-slate-600">9. Liability.</span> Green Residences shall not be held liable for any loss, damage, or inconvenience arising from the cancellation or rescheduling of a viewing appointment.</p>
                            <p><span class="font-medium text-slate-600">10. Acceptance.</span> By checking the box below and clicking "Continue", you confirm that you have read, understood, and agree to these Terms &amp; Conditions in full.</p>
                        </div>

                        <label class="flex items-start gap-2.5 mt-2.5 cursor-pointer">
                            <input type="checkbox" ng-model="bkTcChecked"
                                   class="mt-0.5 w-4 h-4 rounded border-slate-300 accent-green-600 cursor-pointer flex-shrink-0" />
                            <span class="text-xs text-slate-600 leading-relaxed">
                                I have read and agree to the <span class="text-green-700 font-medium">Terms &amp; Conditions</span> of Green Residences.
                            </span>
                        </label>
                    </div>

                    <button ng-click="bkSendOtp()" ng-disabled="bkLoading || !bkTcChecked"
                            ng-class="{'opacity-60 cursor-not-allowed': bkLoading || !bkTcChecked}"
                            class="w-full flex items-center justify-center gap-2 py-3 bg-green-600 hover:bg-green-700 text-white rounded-xl text-sm font-medium transition-all focus:outline-none focus:ring-2 focus:ring-green-500">
                        {{ bkLoading ? 'Sending code...' : 'Continue' }}
                    </button>
                </div>

                <p class="text-center text-slate-400 text-xs mt-4">
                    A verification code will be sent to your email to confirm your identity.
                </p>
            </div>

            <!-- ============ STEP 2 — VERIFY OTP ============ -->
            <div ng-show="bkStep === 'verify'" class="p-6">
                <div class="flex justify-center mb-5">
                    <div class="w-14 h-14 bg-green-100 rounded-2xl flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600">
                            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
                            <path d="m9 12 2 2 4-4" />
                        </svg>
                    </div>
                </div>

                <div class="text-center mb-6">
                    <h3 class="text-slate-900 mb-1 font-semibold">Check your email</h3>
                    <p class="text-slate-500 text-sm">A 6-digit verification code was sent to</p>
                    <p class="text-green-600 text-sm font-medium mt-0.5">{{ bkEmail }}</p>
                </div>

                <label class="block text-sm text-slate-700 font-medium mb-3 text-center">Enter verification code</label>

                <div class="flex gap-2 justify-center mb-5">
                    <input ng-repeat="i in [0,1,2,3,4,5]"
                           id="bkOtp{{ i }}"
                           type="text"
                           inputmode="numeric"
                           input-rule="digit"
                           ng-model="bkOtp[i]"
                           ng-change="bkOtpNext(i)"
                           ng-keydown="bkOtpBack($event, i)"
                           class="w-11 text-center text-lg font-bold border-2 border-slate-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all bg-slate-50 text-slate-900"
                           style="height: 52px;"
                           aria-label="Digit {{ i + 1 }}" />
                </div>

                <button ng-click="bkVerify()" ng-disabled="bkOtpLoading"
                        ng-class="{'opacity-60': bkOtpLoading}"
                        class="w-full flex items-center justify-center gap-2 py-3 bg-green-600 hover:bg-green-700 text-white rounded-xl text-sm font-medium transition-all focus:outline-none focus:ring-2 focus:ring-green-500">
                    {{ bkOtpLoading ? 'Verifying...' : 'Verify and Continue' }}
                </button>

                <div class="mt-4 text-center">
                    <p class="text-slate-500 text-xs mb-2">Didn't receive the code?</p>
                    <button ng-click="bkSendOtp()" ng-disabled="bkCooldown > 0"
                            ng-class="{'text-slate-400 cursor-not-allowed': bkCooldown > 0, 'text-green-600 hover:text-green-700': bkCooldown === 0}"
                            class="inline-flex items-center gap-1.5 text-sm font-medium transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                            <path d="M21 3v5h-5" />
                            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
                            <path d="M8 16H3v5" />
                        </svg>
                        {{ bkCooldown > 0 ? 'Resend in ' + bkCooldown + 's' : 'Resend code' }}
                    </button>
                </div>

                <button ng-click="bkStep = 'auth'; bkOtp = []"
                        class="mt-4 w-full flex items-center justify-center gap-2 text-sm text-slate-500 hover:text-slate-700 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m15 18-6-6 6-6" />
                    </svg>
                    Change details
                </button>
            </div>

            <!-- ============ STEP 3 — CALENDAR ============ -->
            <div ng-show="bkStep === 'calendar'" class="p-6">

                <div class="flex items-center justify-between gap-2 bg-green-50 border border-green-100 rounded-xl px-3 py-2 mb-4">
                    <div class="flex items-center gap-2 min-w-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600 flex-shrink-0">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                            <path d="m9 11 3 3L22 4" />
                        </svg>
                        <p class="text-green-700 text-xs truncate">
                            Booking as <span class="font-semibold">{{ bkName }}</span>
                            <span class="text-green-500 ml-1 hidden sm:inline">&middot; {{ bkEmail }}</span>
                        </p>
                    </div>
                    <button ng-click="bkSwitchAccount()" title="Sign out and use a different account"
                            class="flex items-center gap-1 text-xs text-red-500 hover:text-red-700 hover:bg-red-50 px-2 py-1 rounded-lg transition-all whitespace-nowrap flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" x2="9" y1="12" y2="12" />
                        </svg>
                        Switch
                    </button>
                </div>

                <div class="flex items-center justify-between mb-4">
                    <button ng-click="bkShiftMonth(-1)" class="p-2 rounded-lg hover:bg-slate-100 transition-colors" aria-label="Previous month">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m15 18-6-6 6-6" />
                        </svg>
                    </button>
                    <h3 class="text-slate-900 font-semibold">{{ MONTHS_FULL[bkViewMonth] }} {{ bkViewYear }}</h3>
                    <button ng-click="bkShiftMonth(1)" class="p-2 rounded-lg hover:bg-slate-100 transition-colors" aria-label="Next month">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                    </button>
                </div>

                <div class="grid grid-cols-7 gap-1 mb-2">
                    <div ng-repeat="d in bkDAYS" class="text-center text-xs text-slate-400 py-1">{{ d }}</div>
                </div>

                <div class="grid grid-cols-7 gap-1">
                    <div ng-repeat="e in bkEmptySlots track by $index"></div>

                    <button ng-repeat="day in bkMonthDays track by day.dateStr"
                            ng-click="bkSelectDate(day)"
                            ng-disabled="day.isPast || day.isBusy"
                            title="{{ day.isBusy ? 'Admin is busy on this day — unavailable for booking' : (day.hasBooking ? 'Some time slots are already booked on this day' : '') }}"
                            ng-class="{
                                'bg-green-600 text-white shadow-md': bkSelectedDate === day.dateStr,
                                'bg-orange-100 text-orange-400 cursor-not-allowed': bkSelectedDate !== day.dateStr && day.isBusy,
                                'bg-green-50 text-green-600 font-semibold border border-green-200': bkSelectedDate !== day.dateStr && !day.isBusy && day.isToday,
                                'hover:bg-slate-100 text-slate-700': bkSelectedDate !== day.dateStr && !day.isBusy && !day.isToday && !day.isPast,
                                'text-slate-200 cursor-not-allowed': day.isPast && !day.isBusy
                            }"
                            class="relative aspect-square rounded-xl text-sm transition-all focus:outline-none focus:ring-2 focus:ring-green-500">
                        {{ day.num }}
                        <span ng-if="day.isBusy" class="absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 bg-orange-400 rounded-full"></span>
                        <span ng-if="day.hasBooking && !day.isBusy && bkSelectedDate !== day.dateStr" class="absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 bg-red-400 rounded-full"></span>
                    </button>
                </div>

                <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-slate-500 border-t border-slate-100 pt-3">
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-md bg-green-600 flex-shrink-0"></span> Selected</span>
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-md bg-green-50 border border-green-200 flex-shrink-0"></span> Today</span>
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-md bg-orange-100 flex-shrink-0"></span> Admin busy — unavailable</span>
                </div>
            </div>

            <!-- ============ STEP 4 — SLOTS ============ -->
            <div ng-show="bkStep === 'slots'" class="p-6">
                <button ng-click="bkStep = 'calendar'" class="flex items-center gap-1 text-sm text-slate-500 hover:text-slate-700 mb-4 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m15 18-6-6 6-6" />
                    </svg>
                    Back to calendar
                </button>

                <p class="text-slate-600 text-sm mb-1">
                    <span class="text-slate-900 font-medium">{{ bkFormatDate(bkSelectedDate) }}</span> — Select a time slot:
                </p>
                <p class="text-xs text-slate-400 mb-4 flex items-center gap-1.5">
                    <span class="inline-block w-2.5 h-2.5 rounded bg-red-100 border border-red-200"></span>
                    Red slots are already booked and unavailable.
                </p>

                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                    <button ng-repeat="slot in timeOptions"
                            ng-click="bkSelectSlot(slot)"
                            ng-disabled="bkIsSlotBlocked(slot)"
                            ng-class="bkIsSlotBlocked(slot)
                                        ? 'bg-red-50 text-red-400 border-red-200 cursor-not-allowed'
                                        : 'hover:border-green-300 hover:bg-green-50 hover:text-green-700 text-slate-700 border-slate-200 cursor-pointer'"
                            class="relative flex flex-col items-center justify-center gap-1 py-3 rounded-xl border text-sm transition-all focus:outline-none focus:ring-2 focus:ring-green-500">
                        <span class="flex items-center gap-1.5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10" />
                                <polyline points="12 6 12 12 16 14" />
                            </svg>
                            {{ slot }}
                        </span>
                        <span ng-if="bkIsSlotBlocked(slot)" class="text-xs text-red-300">Unavailable</span>
                    </button>
                </div>
            </div>

            <!-- ============ STEP 5 — FORM (notes) ============ -->
            <div ng-show="bkStep === 'form'" class="p-6">
                <button ng-click="bkStep = 'slots'" class="flex items-center gap-1 text-sm text-slate-500 hover:text-slate-700 mb-4 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m15 18-6-6 6-6" />
                    </svg>
                    Back to time slots
                </button>

                <div class="bg-green-50 border border-green-100 rounded-xl p-3 mb-4 text-sm text-green-800">
                    📅 {{ bkFormatDate(bkSelectedDate) }} at {{ bkSelectedSlot }}
                </div>

                <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 mb-4 space-y-2">
                    <div class="flex items-center justify-between mb-2">
                        <p class="text-xs text-slate-500 font-medium uppercase tracking-wide">Your Info</p>
                        <button ng-click="bkSwitchAccount()" class="flex items-center gap-1 text-xs text-red-500 hover:text-red-700 hover:bg-red-50 px-2 py-1 rounded-lg transition-all">
                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                <polyline points="16 17 21 12 16 7" />
                                <line x1="21" x2="9" y1="12" y2="12" />
                            </svg>
                            Switch Account
                        </button>
                    </div>
                    <div class="text-sm text-slate-700">{{ bkName }}</div>
                    <div class="text-sm text-slate-700">{{ bkEmail }}</div>
                    <div class="text-sm text-slate-700">{{ bkPhone }}</div>
                </div>

                <div ng-if="bkLimitError" class="p-3 bg-red-50 border border-red-100 rounded-xl text-red-700 text-xs mb-4">
                    {{ bkLimitError }}
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm text-slate-700 mb-1" for="bkNotes">Notes (optional)</label>
                        <textarea id="bkNotes" ng-model="bkNotes" rows="3"
                                  input-rule="description" input-rule-label="Notes" input-rule-max="500"
                                  placeholder="Any questions or special requests..."
                                  class="w-full px-3 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-sm focus:outline-none focus:ring-2 focus:ring-green-500 resize-none"></textarea>
                    </div>

                    <button ng-click="bkStep = 'confirm'"
                            class="w-full py-3 bg-green-600 hover:bg-green-700 text-white rounded-xl text-sm font-medium transition-all focus:outline-none focus:ring-2 focus:ring-green-500">
                        Review Booking &rarr;
                    </button>
                </div>
            </div>

            <!-- ============ STEP 6 — CONFIRM ============ -->
            <div ng-show="bkStep === 'confirm'" class="p-6">
                <button ng-click="bkStep = 'form'" class="flex items-center gap-1 text-sm text-slate-500 hover:text-slate-700 mb-5 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m15 18-6-6 6-6" />
                    </svg>
                    Back
                </button>

                <div class="bg-green-50 border border-green-200 rounded-2xl p-5 mb-5 space-y-3">
                    <p class="text-xs text-green-600 font-semibold uppercase tracking-wide mb-1">Booking Summary</p>

                    <div class="flex items-center gap-2 text-sm text-green-800">
                        <span class="text-base">🏠</span>
                        <div>
                            <p class="text-xs text-green-600">Unit</p>
                            <p class="font-medium">{{ currentUnit.name }}</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 text-sm text-green-800">
                        <span class="text-base">📅</span>
                        <div>
                            <p class="text-xs text-green-600">Date &amp; Time</p>
                            <p class="font-medium">{{ bkFormatDate(bkSelectedDate) }} at {{ bkSelectedSlot }}</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 text-sm text-green-800">
                        <span class="text-base">👤</span>
                        <div>
                            <p class="text-xs text-green-600">Guest</p>
                            <p class="font-medium">{{ bkName }}</p>
                            <p class="text-xs text-green-600">{{ bkEmail }}</p>
                        </div>
                    </div>

                    <div ng-if="bkNotes" class="flex items-start gap-2 text-sm text-green-800">
                        <span class="text-base">📝</span>
                        <div>
                            <p class="text-xs text-green-600">Notes</p>
                            <p class="text-green-700 italic">"{{ bkNotes }}"</p>
                        </div>
                    </div>
                </div>

                <div class="bg-amber-50 border border-amber-100 rounded-xl p-3 mb-5 text-xs text-amber-700">
                    ⚠️ Once submitted, your booking will be <strong>reviewed by the admin</strong>. You'll receive a confirmation shortly.
                </div>

                <div ng-if="currentUnit.joinable" class="bg-blue-50 border border-blue-100 rounded-xl p-3 mb-5 text-xs text-blue-700">
                    You confirmed that this viewing is for one bedspace in a shared unit.
                </div>

                <div class="flex gap-3">
                    <button ng-click="bkStep = 'form'"
                            class="flex-1 py-3 rounded-xl border border-slate-200 text-slate-600 text-sm font-medium hover:bg-slate-50 transition-all focus:outline-none">
                        Edit
                    </button>
                    <button ng-click="bkSubmit()" ng-disabled="bkSubmitting"
                            ng-class="{'opacity-60': bkSubmitting}"
                            class="flex-1 flex items-center justify-center gap-2 py-3 bg-green-600 hover:bg-green-700 text-white rounded-xl text-sm font-medium transition-all focus:outline-none focus:ring-2 focus:ring-green-500">
                        {{ bkSubmitting ? 'Submitting...' : 'Submit Booking' }}
                    </button>
                </div>
            </div>

            <!-- ============ STEP 7 — SUCCESS ============ -->
            <div ng-show="bkStep === 'success'" class="p-8 text-center">
                <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                        <path d="m9 11 3 3L22 4" />
                    </svg>
                </div>

                <h2 class="text-slate-900 mb-2 text-xl font-bold">Booking Submitted!</h2>
                <p class="text-slate-500 text-sm mb-2">
                    Your viewing request for <strong>{{ bkResult.unitName }}</strong> has been submitted.
                </p>

                <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-3 mb-4 text-sm text-emerald-800 inline-block">
                    📅 {{ bkResult.datetime }}
                </div>

                <p class="text-slate-400 text-xs mb-6">
                    A confirmation has been sent to <strong>{{ bkEmail }}</strong>
                </p>

                <button ng-click="bookingOpen = false"
                        class="px-6 py-2.5 rounded-xl bg-green-600 hover:bg-green-700 text-white text-sm font-medium transition-all">
                    Done
                </button>
            </div>

        </div>
    </div>

</div>
<!-- Toast Notification -->
<div ng-show="toastShow" style="animation: slideDown 0.5s ease-in-out"
     class="fixed top-4 right-4 z-[100] flex items-center gap-3 bg-white border shadow-sm rounded-2xl px-5 py-4 w-[400px] max-w-full transition-all duration-300"
     ng-class="{'border-green-200': toast.type === 'success', 'border-red-200': toast.type === 'error'}">
    <span class="font-medium text-[15px]" ng-class="{'text-green-700': toast.type === 'success', 'text-red-700': toast.type === 'error'}">
        {{ toast.message }}
    </span>
</div>
