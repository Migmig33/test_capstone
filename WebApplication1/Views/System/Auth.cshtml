@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<style>
    /* Smooth fade up for the forms when they appear */
    .animate-step {
        animation: formFadeUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    @@keyframes formFadeUp {
        0% {
            opacity: 0;
            transform: translateY(10px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<!-- Toast Notification -->
<div ng-show="toastShow" style="animation: slideDown 0.5s ease-in-out"
     class="fixed top-4 right-4 z-[300] flex items-center gap-3 bg-white border shadow-sm rounded-2xl px-5 py-4 w-[350px] max-w-full transition-all duration-300"
     ng-class="{'border-green-200': toast.type === 'success', 'border-red-200': toast.type === 'error'}">
    <span class="font-medium text-[14px]" ng-class="{'text-green-700': toast.type === 'success', 'text-red-700': toast.type === 'error'}">
        {{ toast.message }}
    </span>
</div>

<!-- Main Background -->
<div class="min-h-screen bg-slate-900 bg-gradient-to-br from-slate-900 via-slate-800 to-black flex items-center justify-center p-4 sm:p-6 relative overflow-hidden font-sans" ng-init="initLogin()">

    <!-- Ambient Blur Effects -->
    <div class="absolute top-1/4 left-1/4 w-72 h-72 bg-green-600/20 rounded-full blur-[80px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 w-72 h-72 bg-emerald-800/20 rounded-full blur-[80px] pointer-events-none"></div>

    <!-- Container -->
    <div class="relative w-full max-w-[850px] min-h-[600px] lg:min-h-0 lg:h-[550px] bg-white rounded-2xl sm:rounded-3xl shadow-2xl flex flex-col lg:block overflow-hidden border border-slate-700/50">

        <!-- ================= RECOVERY FORMS (STATIC LEFT SIDE) ================= -->
        <!-- On mobile, hidden unless recovery step is active. On desktop, always present under the sliding overlay. -->
        <div class="relative lg:absolute top-0 left-0 w-full lg:w-1/2 flex-1 lg:h-full flex-col justify-center bg-white p-6 lg:p-10 z-10"
             ng-class="{'hidden lg:flex': step === 'credentials' || step === 'verify', 'flex': step === 'forgot' || step === 'forgot-otp' || step === 'reset'}">

            <div class="w-full max-w-[320px] mx-auto">

                <!-- FORGOT STEP -->
                <div ng-show="step === 'forgot'" class="animate-step">
                    <div class="flex justify-center mb-4">
                        <div class="w-12 h-12 bg-green-50 border border-green-100 rounded-2xl flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600">
                                <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z" />
                                <circle cx="16.5" cy="7.5" r=".5" fill="currentColor" />
                            </svg>
                        </div>
                    </div>

                    <div class="text-center mb-5">
                        <h2 class="text-slate-900 text-xl font-extrabold mb-1.5">Forgot Password?</h2>
                        <p class="text-slate-500 text-[13px] leading-relaxed">
                            Enter your registered email to receive a reset code.
                        </p>
                    </div>

                    <div class="space-y-3.5">
                        <div>
                            <label class="block text-[12px] text-slate-700 font-bold mb-1.5">Email Address</label>
                            <div class="relative">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
                                    <rect width="20" height="16" x="2" y="4" rx="2" />
                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                                </svg>
                                <input type="text" ng-model="fpEmail" placeholder="your@greenresidences.ph" inputmode="email"
                                       input-rule="email" input-rule-label="Email" input-rule-required
                                       class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-[13px] focus:outline-none focus:ring-2 focus:ring-green-500 transition-all" />
                            </div>
                        </div>

                        <button ng-click="sendResetCode()" ng-disabled="fpLoading" ng-class="{'opacity-70': fpLoading}"
                                class="w-full flex items-center justify-center gap-2 py-3 bg-green-600 hover:bg-green-700 text-white rounded-xl text-[13px] font-semibold transition-all shadow-md shadow-green-200 focus:outline-none focus:ring-2 focus:ring-green-500 mt-2">
                            {{ fpLoading ? 'Sending…' : 'Send Reset Code' }}
                        </button>
                    </div>

                    <button ng-click="step = 'credentials'" class="lg:hidden mt-5 w-full flex items-center justify-center gap-2 text-[13px] font-medium text-slate-500 hover:text-slate-800 transition-colors">
                        Back to sign in
                    </button>
                </div>

                <!-- FORGOT OTP STEP -->
                <div ng-show="step === 'forgot-otp'" class="animate-step">
                    <div class="flex justify-center mb-4">
                        <div class="w-12 h-12 bg-green-50 border border-green-100 rounded-2xl flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600">
                                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
                                <path d="m9 12 2 2 4-4" />
                            </svg>
                        </div>
                    </div>
                    <div class="text-center mb-5">
                        <h2 class="text-slate-900 text-xl font-extrabold mb-1.5">Check your inbox</h2>
                        <p class="text-slate-500 text-[13px]">A 6-digit code was sent to <br /><span class="text-green-600 font-bold">{{ fpEmail }}</span></p>
                    </div>
                    <div class="flex gap-1.5 justify-center mb-5">
                        <input ng-repeat="i in [0,1,2,3,4,5]" id="fpOtp{{ i }}" type="text" inputmode="numeric" input-rule="digit" ng-model="fpOtp[i]" ng-change="fpOtpNext(i)"
                               class="w-[42px] h-[48px] text-center text-lg font-bold border-2 border-slate-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all bg-slate-50 text-slate-900" />
                    </div>
                    <button ng-click="verifyResetCode()" ng-disabled="fpLoading" ng-class="{'opacity-60': fpLoading}"
                            class="w-full flex items-center justify-center gap-2 py-3 bg-green-600 hover:bg-green-700 text-white rounded-xl text-[13px] font-semibold transition-all shadow-md shadow-green-200">
                        {{ fpLoading ? 'Verifying…' : 'Verify Code' }}
                    </button>
                    <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-5">
                        <button ng-click="step = 'forgot'" class="text-[12px] font-semibold text-slate-500 hover:text-slate-800">Change email</button>
                        <button ng-click="sendResetCode()" ng-disabled="fpCooldown > 0" class="text-[12px] font-semibold disabled:text-slate-400" ng-class="fpCooldown === 0 ? 'text-green-600 hover:text-green-700' : ''">
                            {{ fpCooldown > 0 ? 'Resend in ' + fpCooldown + 's' : 'Resend code' }}
                        </button>
                    </div>
                </div>

                <!-- RESET PASSWORD STEP -->
                <div ng-show="step === 'reset'" class="animate-step">
                    <div class="text-center mb-5">
                        <h2 class="text-slate-900 text-xl font-extrabold mb-1.5">Set New Password</h2>
                        <p class="text-slate-500 text-[13px]">Create a new password for <span class="font-bold text-slate-700">{{ fpEmail }}</span></p>
                    </div>
                    <div class="space-y-3.5">
                        <div>
                            <input type="password" ng-model="fpNewPw" placeholder="New Password (Min. 8 characters)"
                                   input-rule="password" input-rule-label="New password" input-rule-min="8" input-rule-max="64" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-[13px] focus:outline-none focus:ring-2 focus:ring-green-500" />
                            <div ng-if="fpNewPw" class="mt-2">
                                <div class="h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                    <div class="h-full rounded-full transition-all duration-300" ng-class="pwStrength().color" ng-style="{ width: pwStrength().pct + '%' }"></div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <input type="password" ng-model="fpConfirmPw" placeholder="Confirm Password"
                                   input-rule="password" input-rule-label="Confirm password" input-rule-min="0" input-rule-max="64" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-[13px] focus:outline-none focus:ring-2 focus:ring-green-500" />
                        </div>
                        <button ng-click="resetPassword()" ng-disabled="!canSavePassword()" ng-class="{'opacity-60 cursor-not-allowed': !canSavePassword()}"
                                class="w-full py-3 bg-green-600 hover:bg-green-700 text-white rounded-xl text-[13px] font-semibold transition-all shadow-md shadow-green-200 mt-2">
                            {{ fpSaving ? 'Saving…' : 'Save New Password' }}
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <!-- ================= LOGIN FORMS (STATIC RIGHT SIDE) ================= -->
        <!-- On mobile, hidden unless login step is active. On desktop, always present under the sliding overlay. -->
        <div class="relative lg:absolute top-0 right-0 w-full lg:w-1/2 flex-1 lg:h-full flex-col justify-center bg-white p-6 lg:p-10 z-10"
             ng-class="{'hidden lg:flex': step === 'forgot' || step === 'forgot-otp' || step === 'reset', 'flex': step === 'credentials' || step === 'verify'}">

            <div class="w-full max-w-[320px] mx-auto">

                <!-- CREDENTIALS STEP -->
                <div ng-show="step === 'credentials'" class="animate-step">
                    <div class="mb-6">
                        <p class="text-slate-500 font-bold tracking-widest text-[10px] uppercase mb-1.5">Welcome Back</p>
                        <h2 class="text-2xl font-extrabold text-slate-900 mb-1.5">Sign in to continue</h2>
                        <p class="text-slate-500 text-[13px]">Enter your account email and password.</p>
                    </div>

                    <form class="space-y-4">
                        <div>
                            <label class="block text-[12px] font-bold text-slate-700 mb-1.5">Email Address</label>
                            <input type="text" ng-model="email" placeholder="name@example.com" inputmode="email"
                                   input-rule="email" input-rule-label="Email" input-rule-required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-[13px] focus:outline-none focus:ring-2 focus:ring-green-500 transition-all" />
                        </div>
                        <div>
                            <label class="block text-[12px] font-bold text-slate-700 mb-1.5">Password</label>
                            <input type="password" ng-model="password" placeholder="Enter your password" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-[13px] focus:outline-none focus:ring-2 focus:ring-green-500 transition-all" />
                        </div>
                        <button ng-click="authFunc()" ng-disabled="loading" class="w-full flex items-center justify-center gap-2 py-3 bg-green-600 hover:bg-green-700 disabled:opacity-60 text-white rounded-xl text-[13px] font-semibold transition-all shadow-md shadow-green-200 mt-2">
                            <span ng-if="!loading">Sign In</span>
                            <span ng-if="loading">Signing in...</span>
                        </button>

                        <!-- Mobile specific actions -->
                        <div class="lg:hidden mt-4 text-center">
                            <button type="button" ng-click="step = 'forgot'" class="text-[12px] text-green-600 hover:text-green-700 font-semibold transition-colors">
                                Forgot password?
                            </button>
                        </div>

                        <div class="mt-6 text-center">
                            <a href="/" class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-500 hover:text-slate-800 transition-colors group">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:-translate-x-1 transition-transform">
                                    <path d="m12 19-7-7 7-7" />
                                    <path d="M19 12H5" />
                                </svg>
                                Go back to public site
                            </a>
                        </div>
                    </form>
                </div>

                <!-- OTP VERIFICATION STEP -->
                <div ng-show="step === 'verify'" class="animate-step">
                    <div class="mb-6 text-center">
                        <h2 class="text-xl font-extrabold text-slate-900 mb-1.5">Security Check</h2>
                        <p class="text-slate-500 text-[13px]">6-digit code sent to <br /><span class="font-bold text-slate-800">{{ email }}</span></p>
                    </div>
                    <div class="flex gap-1.5 justify-center mb-6">
                        <input type="text" inputmode="numeric" input-rule="digit" ng-model="otp[0]" ng-change="otpNext(0)" ng-keydown="otpKeyDown($event, 0)" id="otp0" class="w-[42px] h-[48px] text-center text-lg font-bold border-2 border-slate-200 rounded-xl focus:outline-none focus:border-green-500" />
                        <input type="text" inputmode="numeric" input-rule="digit" ng-model="otp[1]" ng-change="otpNext(1)" ng-keydown="otpKeyDown($event, 1)" id="otp1" class="w-[42px] h-[48px] text-center text-lg font-bold border-2 border-slate-200 rounded-xl focus:outline-none focus:border-green-500" />
                        <input type="text" inputmode="numeric" input-rule="digit" ng-model="otp[2]" ng-change="otpNext(2)" ng-keydown="otpKeyDown($event, 2)" id="otp2" class="w-[42px] h-[48px] text-center text-lg font-bold border-2 border-slate-200 rounded-xl focus:outline-none focus:border-green-500" />
                        <input type="text" inputmode="numeric" input-rule="digit" ng-model="otp[3]" ng-change="otpNext(3)" ng-keydown="otpKeyDown($event, 3)" id="otp3" class="w-[42px] h-[48px] text-center text-lg font-bold border-2 border-slate-200 rounded-xl focus:outline-none focus:border-green-500" />
                        <input type="text" inputmode="numeric" input-rule="digit" ng-model="otp[4]" ng-change="otpNext(4)" ng-keydown="otpKeyDown($event, 4)" id="otp4" class="w-[42px] h-[48px] text-center text-lg font-bold border-2 border-slate-200 rounded-xl focus:outline-none focus:border-green-500" />
                        <input type="text" inputmode="numeric" input-rule="digit" ng-model="otp[5]" ng-change="otpNext(5)" ng-keydown="otpKeyDown($event, 5)" id="otp5" class="w-[42px] h-[48px] text-center text-lg font-bold border-2 border-slate-200 rounded-xl focus:outline-none focus:border-green-500" />
                    </div>
                    <button ng-click="verifyCode()" ng-disabled="loading" class="w-full flex items-center justify-center gap-2 py-3 bg-green-600 hover:bg-green-700 disabled:opacity-60 text-white rounded-xl text-[13px] font-semibold transition-all shadow-md shadow-green-200">
                        <span ng-if="!loading">Verify &amp; Continue</span>
                        <span ng-if="loading">Verifying...</span>
                    </button>
                    <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-5">
                        <button ng-click="step = 'credentials'" class="text-[12px] font-semibold text-slate-500 hover:text-slate-800">Back</button>
                        <button ng-click="resend()" ng-disabled="resendCooldown > 0" class="text-[12px] font-semibold text-green-600 disabled:text-slate-400">
                            {{ resendCooldown > 0 ? 'Resend in ' + resendCooldown + 's' : 'Resend code' }}
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <!-- ================= SLIDING BRANDING OVERLAY ================= -->
        <!-- `order-first lg:order-none` forces it to the very top on mobile grids -->
        <div class="relative lg:absolute top-0 left-0 w-full lg:w-1/2 h-48 sm:h-56 lg:h-full bg-slate-900 z-20 overflow-hidden shadow-2xl transition-transform duration-[800ms] ease-[cubic-bezier(0.4,0,0.2,1)] order-first lg:order-none"
             ng-class="{'lg:translate-x-full': step === 'forgot' || step === 'forgot-otp' || step === 'reset', 'lg:translate-x-0': step !== 'forgot' && step !== 'forgot-otp' && step !== 'reset'}">

            <div class="absolute inset-0 z-0 pointer-events-none">
                <img src="https://i.imgur.com/ETdDZv3.jpeg" alt="Background" class="w-full h-full object-cover opacity-70" />
                <div class="absolute inset-0 bg-gradient-to-br from-[#2c3d33]/60 via-[#213027]/80 to-[#15201a]/95"></div>
            </div>

            <!-- Overlay Content -->
            <div class="relative z-10 w-full h-full flex flex-col justify-center items-center p-8 lg:p-10 text-center">

                <!-- Overlay Left (Covering Forgot Form) -->
                <div ng-show="step === 'credentials' || step === 'verify'" class="animate-step">
                    <h1 class="text-3xl lg:text-4xl text-white font-extrabold mb-3 leading-tight tracking-tight drop-shadow-md">
                        GreenRent
                    </h1>
                    <p class="text-slate-300 text-[13px] leading-relaxed mb-6 max-w-[260px] mx-auto drop-shadow hidden sm:block">
                        Enter your credentials to access your centralized property management workspace.
                    </p>
                    <button type="button" ng-click="step = 'forgot'" class="hidden lg:inline-block px-6 py-2.5 rounded-full border border-white/40 text-white text-[13px] font-semibold hover:bg-white/10 transition-colors">
                        Forgot Password?
                    </button>
                </div>

                <!-- Overlay Right (Covering Login Form) -->
                <div ng-show="step === 'forgot' || step === 'forgot-otp' || step === 'reset'" class="animate-step">
                    <h1 class="text-3xl lg:text-4xl text-white font-extrabold mb-3 leading-tight tracking-tight drop-shadow-md">
                        Account Recovery
                    </h1>
                    <p class="text-slate-300 text-[13px] leading-relaxed mb-6 max-w-[260px] mx-auto drop-shadow hidden sm:block">
                        Need to get back in? Follow the steps to securely reset your password.
                    </p>
                    <button type="button" ng-click="step = 'credentials'" class="hidden lg:inline-block px-6 py-2.5 rounded-full border border-white/40 text-white text-[13px] font-semibold hover:bg-white/10 transition-colors">
                        Back to Login
                    </button>
                </div>

            </div>
        </div>

    </div>
</div>