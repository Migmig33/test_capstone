
@{
    Layout = "~/Views/Shared/_TenantLayout.cshtml";
}
<!-- Toast Notification -->
<div ng-show="toastShow" style="animation: slideDown 0.5s ease-in-out"
     class="fixed top-4 right-4 z-[300] flex items-center gap-3 bg-white border shadow-sm rounded-2xl px-5 py-4 w-[350px] max-w-full transition-all duration-300"
     ng-class="{'border-green-200': toast.type === 'success', 'border-red-200': toast.type === 'error'}">
    <span class="font-medium text-[14px]" ng-class="{'text-green-700': toast.type === 'success', 'text-red-700': toast.type === 'error'}">
        {{ toast.message }}
    </span>
</div>

<div class="min-h-screen bg-slate-100 flex flex-col lg:flex-row font-sans text-slate-900"
     ng-init="isLoading = true; init()">

    <!-- LEFT SIDEBAR -->
    <aside class="w-full lg:w-80 bg-gradient-to-b from-green-700 to-green-900 text-white p-6 lg:p-8 flex flex-col flex-shrink-0 relative lg:fixed lg:h-screen lg:overflow-y-auto z-10 shadow-xl border-r border-green-800">

        <button type="button"
                ng-click="handleLogout()"
                class="w-10 h-10 rounded-full border border-green-500/50 flex items-center justify-center text-green-100 hover:text-white hover:bg-green-600 mb-8 transition-colors shadow-sm"
                title="Logout">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="20"
                 height="20"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
        </button>

        <!-- Skeleton Profile -->
        <div ng-if="isLoading"
             class="flex flex-col items-start px-2 mb-10 animate-pulse w-full">
            <div class="w-32 h-32 rounded-full bg-green-600/50 mb-6 border-4 border-green-500/30"></div>
            <div class="h-6 bg-green-600/50 rounded w-3/4 mb-2"></div>
            <div class="h-4 bg-green-600/50 rounded w-1/2 mb-8"></div>

            <div class="space-y-5 w-full">
                <div class="h-10 bg-green-600/30 rounded w-full"></div>
                <div class="h-10 bg-green-600/30 rounded w-full"></div>
                <div class="h-10 bg-green-600/30 rounded w-full"></div>
                <div class="h-10 bg-green-600/30 rounded w-full"></div>
            </div>
        </div>

        <!-- Loaded Profile Header -->
        <div ng-if="!isLoading"
             class="flex flex-col items-start px-2 mb-6">

            <div class="relative mb-6">
                <div class="w-32 h-32 rounded-full bg-white flex items-center justify-center shadow-lg shadow-green-900/50 border-4 border-green-500/30">
                    <span class="text-5xl font-bold text-green-700">
                        {{ currentTenant.name ? currentTenant.name[0] : '?' }}
                    </span>
                </div>

                <div class="absolute bottom-1 right-1 w-10 h-10 bg-slate-900 rounded-full flex items-center justify-center text-white border-4 border-green-800 shadow-md">
                    <lucide-icon name="building-2" size="16"></lucide-icon>
                </div>
            </div>

            <h1 class="text-2xl font-bold text-white mb-2">
                {{ currentTenant.name }}
            </h1>

            <div class="inline-flex items-center gap-1.5 bg-green-900/40 px-3 py-1 rounded-full">
                <lucide-icon name="door-closed" size="12" class="text-green-300"></lucide-icon>
                <span class="text-green-100 text-xs font-semibold">
                    Unit {{ currentTenant.unit }}
                </span>
            </div>
        </div>

        <!-- PERSONAL DETAILS -->
        <div ng-if="!isLoading"
             class="flex flex-col px-2 w-full mt-2 border-t border-green-600/50 pt-6">

            <div class="flex items-center justify-between mb-5">
                <p class="text-xs font-semibold text-green-400/80 uppercase tracking-wider">
                    Personal Details
                </p>

                <button type="button"
                        ng-if="!isEditingProfile"
                        ng-click="startEditProfile()"
                        class="flex items-center gap-1 text-[10px] uppercase font-bold tracking-wider bg-green-800/50 hover:bg-green-800 px-2.5 py-1.5 rounded-lg text-green-200 hover:text-white transition-colors">
                    <lucide-icon name="edit-2" size="10"></lucide-icon>
                    Edit
                </button>
            </div>

            <!-- VIEW MODE -->
            <div ng-if="!isEditingProfile"
                 class="flex flex-col space-y-6">

                <div class="flex flex-col gap-1.5">
                    <span class="text-[10px] font-bold text-green-300 uppercase tracking-widest">
                        Email Address
                    </span>
                    <div class="flex items-start gap-2.5 text-green-50">
                        <lucide-icon name="mail" size="16" class="text-green-400/70 mt-0.5 flex-shrink-0"></lucide-icon>
                        <span class="text-sm font-medium break-all">
                            {{ currentTenant.email || '—' }}
                        </span>
                    </div>
                </div>

                <div class="flex flex-col gap-1.5">
                    <span class="text-[10px] font-bold text-green-300 uppercase tracking-widest">
                        Phone Number
                    </span>
                    <div class="flex items-start gap-2.5 text-green-50">
                        <lucide-icon name="phone" size="16" class="text-green-400/70 mt-0.5 flex-shrink-0"></lucide-icon>
                        <span class="text-sm font-medium">
                            {{ currentTenant.phone || '—' }}
                        </span>
                    </div>
                </div>

                <div class="flex flex-col gap-1.5">
                    <span class="text-[10px] font-bold text-green-300 uppercase tracking-widest">
                        Occupation
                    </span>
                    <div class="flex items-start gap-2.5 text-green-50">
                        <lucide-icon name="briefcase" size="16" class="text-green-400/70 mt-0.5 flex-shrink-0"></lucide-icon>
                        <span class="text-sm font-medium">
                            {{ currentTenant.occupation || '—' }}
                        </span>
                    </div>
                </div>

                <div class="flex flex-col gap-1.5">
                    <span class="text-[10px] font-bold text-green-300 uppercase tracking-widest">
                        Address
                    </span>
                    <div class="flex items-start gap-2.5 text-green-50">
                        <lucide-icon name="map-pin" size="16" class="text-green-400/70 mt-0.5 flex-shrink-0"></lucide-icon>
                        <span class="text-sm font-medium leading-relaxed">
                            {{ currentTenant.address || '—' }}
                        </span>
                    </div>
                </div>
            </div>

            <!-- EDIT MODE -->
            <div ng-if="isEditingProfile"
                 class="flex flex-col space-y-4">

                <div class="flex flex-col gap-1.5">
                    <label for="tp-email" class="text-[10px] font-bold text-green-300 uppercase tracking-widest">
                        Email Address
                    </label>
                    <div class="relative">
                        <lucide-icon name="mail" size="14" class="absolute left-3 top-3 text-green-500"></lucide-icon>
                        <input type="text" inputmode="email"
                               ng-model="currentTenant.email" id="tp-email"
                               input-rule="email" input-rule-label="Email" input-rule-required input-rule-group="profile"
                               class="w-full bg-green-900/40 border border-green-600/50 rounded-xl pl-9 pr-3 py-2.5 text-sm text-white focus:outline-none focus:border-green-400 focus:ring-1 focus:ring-green-400 transition-all placeholder-green-700"
                               placeholder="Enter email">
                    </div>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="tp-phone" class="text-[10px] font-bold text-green-300 uppercase tracking-widest">
                        Phone Number
                    </label>
                    <div class="relative">
                        <lucide-icon name="phone" size="14" class="absolute left-3 top-3 text-green-500"></lucide-icon>
                        <input type="text" inputmode="numeric"
                               ng-model="currentTenant.phone" id="tp-phone"
                               input-rule="phone" input-rule-label="Phone number" input-rule-required input-rule-group="profile"
                               class="w-full bg-green-900/40 border border-green-600/50 rounded-xl pl-9 pr-3 py-2.5 text-sm text-white focus:outline-none focus:border-green-400 focus:ring-1 focus:ring-green-400 transition-all placeholder-green-700"
                               placeholder="Enter phone number">
                    </div>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="tp-occupation" class="text-[10px] font-bold text-green-300 uppercase tracking-widest">
                        Occupation
                    </label>
                    <div class="relative">
                        <lucide-icon name="briefcase" size="14" class="absolute left-3 top-3 text-green-500"></lucide-icon>
                        <input type="text"
                               ng-model="currentTenant.occupation" id="tp-occupation"
                               input-rule="occupation" input-rule-label="Occupation" input-rule-required input-rule-group="profile"
                               class="w-full bg-green-900/40 border border-green-600/50 rounded-xl pl-9 pr-3 py-2.5 text-sm text-white focus:outline-none focus:border-green-400 focus:ring-1 focus:ring-green-400 transition-all placeholder-green-700"
                               placeholder="Enter occupation">
                    </div>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="tp-address" class="text-[10px] font-bold text-green-300 uppercase tracking-widest">
                        Address
                    </label>
                    <div class="relative">
                        <lucide-icon name="map-pin" size="14" class="absolute left-3 top-3.5 text-green-500"></lucide-icon>
                        <textarea ng-model="currentTenant.address" id="tp-address"
                                  rows="3"
                                  input-rule="address" input-rule-label="Address" input-rule-required input-rule-max="150" input-rule-group="profile"
                                  class="w-full bg-green-900/40 border border-green-600/50 rounded-xl pl-9 pr-3 py-2.5 text-sm text-white focus:outline-none focus:border-green-400 focus:ring-1 focus:ring-green-400 transition-all placeholder-green-700 resize-none"
                                  placeholder="Enter address"></textarea>
                    </div>
                </div>

                <!-- EDIT ACTION BUTTONS -->
                <div class="flex items-center gap-3 pt-2">
                    <button type="button"
                            ng-click="cancelEditProfile()"
                            ng-disabled="isSavingProfile"
                            class="flex-1 py-2.5 rounded-xl bg-green-800 text-green-200 text-xs font-bold hover:bg-green-900 transition-colors disabled:opacity-50">
                        Cancel
                    </button>

                    <button type="button"
                            class="rounded-xl bg-green-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                            ng-click="openProfileChangeReasonModal()">
                        Save Changes
                    </button>
                </div>
            </div>
        </div>
    </aside>

    <!-- RIGHT CONTENT AREA -->
    <main class="flex-1 min-w-0 lg:ml-80 p-4 sm:p-8 lg:p-12 flex flex-col min-h-screen">

        <!-- HEADER -->
        <div class="flex justify-end items-center mb-8 bg-white px-6 py-4 rounded-2xl shadow-sm border border-slate-200 w-full">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-green-600 rounded-lg flex items-center justify-center shadow-sm">
                    <lucide-icon name="building-2" size="16" class="text-white"></lucide-icon>
                </div>
                <span class="text-xl font-bold tracking-tight text-slate-900">
                    Green<span class="text-green-600">Residences</span>
                    <span class="text-slate-400 text-xs ml-1.5 font-normal">
                        Tenant Portal
                    </span>
                </span>
            </div>
        </div>

        <!-- SKELETON LOADER -->
        <div ng-if="isLoading" class="w-full space-y-8 animate-pulse">
            <div class="h-32 bg-slate-200 rounded-2xl w-full"></div>
            <div class="grid grid-cols-2 gap-6">
                <div class="h-64 bg-slate-200 rounded-2xl"></div>
                <div class="h-64 bg-slate-200 rounded-2xl"></div>
            </div>
        </div>

        <!-- ACTUAL CONTENT -->
        <div ng-if="!isLoading" class="w-full space-y-10 pb-20">

            <!-- WELCOME CARD -->
            <div class="w-full bg-gradient-to-r from-green-600 to-green-700 rounded-3xl p-8 sm:p-10 text-white shadow-xl flex items-center justify-between flex-wrap gap-6 fade-in-up">
                <div>
                    <p class="text-green-200 text-sm mb-1">
                        Welcome back
                        <span class="text-white">
                            · Tenant ID {{ currentTenant.tenantNumber || currentTenant.Tid }}
                        </span>
                    </p>
                    <h2 class="text-white mb-4 text-3xl font-bold">
                        {{ currentTenant.name }}
                    </h2>
                    <div class="flex flex-wrap items-center gap-3 text-sm">
                        <span class="flex items-center gap-1.5 bg-white/15 px-3 py-1 rounded-full">
                            <lucide-icon name="building-2" size="13"></lucide-icon>
                            {{ currentTenant.unit }}
                        </span>

                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold"
                              ng-class="{'bg-white/15 text-white': liveStatus === 'active', 'bg-amber-100 text-amber-800': liveStatus === 'expiring', 'bg-red-100 text-red-700': liveStatus === 'inactive'}">
                            {{ liveStatus === 'expiring' ? 'Lease expiring soon' : (liveStatus === 'inactive' ? 'Lease expired' : 'Active lease') }}
                        </span>

                        <span ng-if="latestPayment"
                              class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium"
                              ng-class="latestPayment.status === 'Paid' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'">
                            <lucide-icon name="credit-card" size="11"></lucide-icon>
                            {{ latestPayment.status === 'Paid' ? 'Rent Paid' : 'Rent Unpaid' }}
                        </span>
                    </div>
                </div>

                <div ng-if="daysLeft !== null"
                     class="bg-white/15 rounded-2xl px-8 py-5 text-center backdrop-blur-sm">
                    <p class="text-green-200 text-xs mb-0.5">Lease ends in</p>
                    <p class="text-4xl font-bold text-white">
                        {{ daysLeft < 0 ? 0 : daysLeft }}
                    </p>
                    <p class="text-green-200 text-sm font-semibold mt-1">days</p>
                </div>
            </div>

            <!-- LEASE DETAILS AND PAYMENTS -->
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-10 w-full">

                <section id="lease-details" class="fade-in-up delay-1">
                    <h2 class="text-slate-500 font-bold uppercase tracking-wider text-xs mb-4 ml-2">
                        Lease Details
                    </h2>
                    <div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm h-full w-full">
                        <div class="grid grid-cols-2 gap-6">

                            <div class="bg-slate-50 border border-slate-100 rounded-2xl p-4">
                                <p class="text-slate-400 text-xs mb-0.5">Unit</p>
                                <p class="text-slate-900 text-sm font-bold">
                                    {{ currentTenant.unit || '—' }}
                                </p>
                            </div>

                            <div class="bg-slate-50 border border-slate-100 rounded-2xl p-4">
                                <p class="text-slate-400 text-xs mb-0.5">Days Remaining</p>
                                <p class="text-slate-900 text-sm font-bold">
                                    {{ daysLeft !== null ? (daysLeft < 0 ? 'Expired' : daysLeft + ' days') : '—' }}
                                </p>
                            </div>

                            <div class="bg-slate-50 border border-slate-100 rounded-2xl p-4">
                                <p class="text-slate-400 text-xs mb-0.5">Lease Start</p>
                                <p class="text-slate-900 text-sm font-bold">
                                    {{ currentTenant.leaseStart || '—' }}
                                </p>
                            </div>

                            <div class="bg-slate-50 border border-slate-100 rounded-2xl p-4">
                                <p class="text-slate-400 text-xs mb-0.5">Lease End</p>
                                <p class="text-slate-900 text-sm font-bold">
                                    {{ currentTenant.leaseEnd || '—' }}
                                </p>
                            </div>

                            <div class="bg-slate-50 border border-slate-100 rounded-2xl p-4 col-span-2">
                                <p class="text-slate-400 text-xs mb-0.5">Phone</p>
                                <p class="text-slate-900 text-sm font-medium">
                                    {{ currentTenant.phone || '—' }}
                                </p>
                            </div>

                            <div class="bg-slate-50 border border-slate-100 rounded-2xl p-4 col-span-2">
                                <p class="text-slate-400 text-xs mb-0.5">Address</p>
                                <p class="text-slate-900 text-sm font-medium">
                                    {{ currentTenant.address || '—' }}
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- PAYMENT HISTORY -->
                <section id="payments" class="fade-in-up delay-2">
                    <h2 class="text-slate-500 font-bold uppercase tracking-wider text-xs mb-4 ml-2">
                        Payment History
                    </h2>
                    <div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm h-full flex flex-col w-full">

                        <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-100">
                            <h3 class="text-lg font-bold text-slate-900">Records</h3>
                            <span ng-if="myPayments.length > 0"
                                  class="text-xs font-bold text-slate-500 bg-slate-100 px-3 py-1.5 rounded-full">
                                {{ paidPaymentsCount }} of {{ myPayments.length }} paid
                            </span>
                        </div>

                        <p ng-if="paymentsLoadFailed"
                           role="alert"
                           class="text-red-600 text-sm flex-1 flex items-center justify-center text-center">
                            Payment records could not be loaded. Refresh the page to try again.
                        </p>

                        <p ng-if="!paymentsLoadFailed && myPayments.length === 0"
                           class="text-slate-400 text-sm flex-1 flex items-center justify-center">
                            No payment records found.
                        </p>

                        <div class="space-y-4 flex-1 overflow-y-auto pr-2"
                             ng-if="myPayments.length > 0">
                            <div ng-repeat="p in myPayments"
                                 class="flex items-center justify-between p-4 border border-slate-100 rounded-2xl"
                                 ng-class="getPaymentRowClass(p.status)">

                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-xl flex items-center justify-center shadow-sm bg-white">
                                        <lucide-icon ng-if="p.status === 'Paid'"
                                                     name="check-circle"
                                                     size="20"
                                                     class="text-emerald-500"></lucide-icon>
                                        <lucide-icon ng-if="p.status === 'Overdue'"
                                                     name="x-circle"
                                                     size="20"
                                                     class="text-red-500"></lucide-icon>
                                        <lucide-icon ng-if="p.status !== 'Paid' && p.status !== 'Overdue'"
                                                     name="alert-circle"
                                                     size="20"
                                                     class="text-amber-500"></lucide-icon>
                                    </div>

                                    <div>
                                        <p class="text-base font-bold text-slate-800">{{ p.month }}</p>
                                        <p class="text-xs text-slate-500 mt-0.5">Due: {{ p.dueDate }}</p>
                                        <p ng-if="p.paidDate"
                                           class="text-xs text-emerald-600 font-medium mt-0.5">
                                            ✓ Paid: {{ p.paidDate }}
                                        </p>
                                    </div>
                                </div>

                                <div class="text-right">
                                    <p class="text-lg font-bold text-slate-900">
                                        ₱{{ p.amount | number }}
                                    </p>
                                    <span class="inline-block mt-1 text-[10px] font-bold px-2 py-0.5 rounded-full"
                                          ng-class="getPaymentBadgeClass(p.status)">
                                        {{ p.status }}
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <!-- MAINTENANCE REQUESTS -->
            <section id="maintenance" class="fade-in-up delay-3 w-full">

                <div class="flex items-center justify-between mb-4 px-2">
                    <h2 class="text-slate-500 font-bold uppercase tracking-wider text-xs">
                        Maintenance Requests
                    </h2>

                    <button type="button"
                            ng-click="toggleRequestForm()"
                            class="text-white text-sm font-semibold flex items-center gap-2 bg-green-600 hover:bg-green-700 px-4 py-2 rounded-xl transition-all shadow-sm shadow-green-200 focus:ring-2 focus:ring-green-500">
                        <lucide-icon ng-if="!showRequestForm" name="plus" size="16"></lucide-icon>
                        <lucide-icon ng-if="showRequestForm" name="chevron-up" size="16"></lucide-icon>
                        {{ showRequestForm ? 'Cancel' : 'New Request' }}
                    </button>
                </div>

                <div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm w-full">

                    <div ng-if="showRequestForm"
                         class="bg-green-50 border border-green-100 rounded-2xl p-6 mb-8">
                        <p class="text-sm text-green-800 font-bold mb-5">
                            Submit a New Request
                        </p>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div class="md:col-span-1">
                                <label class="block text-xs font-bold text-slate-600 mb-2">
                                    Category *
                                </label>
                                <select name="reqCategory"
                                        ng-model="requestForm.reqCategory"
                                        class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-green-500">
                                    <option ng-repeat="c in MAINTENANCE_CATEGORIES"
                                            value="{{ c }}">
                                        {{ c }}
                                    </option>
                                </select>
                            </div>

                            <div class="md:col-span-2">
                                <label class="block text-xs font-bold text-slate-600 mb-2">
                                    Description *
                                    <span class="text-slate-400 font-normal">
                                        (describe the issue clearly)
                                    </span>
                                </label>
                                <div class="relative">
                                    <textarea name="reqDescription"
                                              ng-model="requestForm.reqDescription"
                                              input-rule="description" input-rule-label="Description" input-rule-required input-rule-max="100" input-rule-group="maintenance"
                                              rows="2"
                                              placeholder="e.g. The bathroom faucet has been leaking..."
                                              class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-white text-sm resize-none focus:outline-none focus:ring-2 focus:ring-green-500"></textarea>
                                    <span class="absolute bottom-3 right-3 text-xs text-slate-400">
                                        {{ (requestForm.reqDescription || '').length }}/100
                                    </span>
                                </div>
                            </div>

                            <div class="md:col-span-3 flex justify-end">
                                <button type="button"
                                        ng-click="handleSubmitRequest()"
                                        ng-disabled="submitting"
                                        class="px-8 py-3 bg-green-600 hover:bg-green-700 disabled:opacity-60 text-white rounded-xl text-sm font-bold transition-all shadow-md focus:ring-2 focus:ring-green-500">
                                    <lucide-icon name="send" size="14" class="inline mr-1"></lucide-icon>
                                    {{ submitting ? 'Submitting…' : 'Submit Request' }}
                                </button>
                            </div>
                        </div>
                    </div>

                    <div ng-if="maintenanceLoadFailed"
                         role="alert"
                         class="text-center py-8 text-red-600 text-sm">
                        Maintenance requests could not be loaded. Refresh the page to try again.
                    </div>

                    <div ng-if="!maintenanceLoadFailed && myMaintenance.length === 0"
                         class="text-center py-8">
                        <lucide-icon name="wrench" size="28" class="text-slate-200 mx-auto mb-2"></lucide-icon>
                        <p class="text-slate-400 text-sm">
                            No maintenance requests yet.
                        </p>
                        <p class="text-slate-400 text-xs mt-0.5">
                            Submit a request above when something needs fixing.
                        </p>
                    </div>

                    <div ng-if="myMaintenance.length > 0"
                         class="space-y-4">
                        <div ng-repeat="m in myMaintenance"
                             class="flex items-center gap-4 p-5 bg-slate-50 border border-slate-200 rounded-2xl shadow-sm hover:shadow-md transition-shadow">

                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-3 mb-1">
                                    <p class="text-sm font-bold text-slate-800">
                                        {{ m.category }}
                                    </p>
                                    <span class="text-xs px-2.5 py-1 rounded-full font-medium"
                                          ng-class="getMaintenanceStatusClass(m.status)">
                                        {{ m.status }}
                                    </span>
                                </div>

                                <p class="text-sm text-slate-500">{{ m.description }}</p>

                                <span ng-if="m.photoUrl"
                                      class="mt-2 inline-flex items-center gap-1 text-xs text-green-700 bg-green-50 border border-green-100 px-2 py-0.5 rounded-full">
                                    <lucide-icon name="image" size="10"></lucide-icon>
                                    Photo attached
                                </span>

                                <p class="text-xs text-slate-400 mt-2">
                                    Reported: {{ formatPortalDate(m.reportedDate) }}
                                    <span ng-if="m.resolvedDate">
                                        · Resolved: {{ formatPortalDate(m.resolvedDate) }}
                                    </span>
                                </p>

                                <div ng-if="m.scheduledDate"
                                     class="mt-2 inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-green-50 border border-green-100 rounded-lg text-xs text-green-700">
                                    <lucide-icon name="calendar-clock" size="12"></lucide-icon>
                                    <span>
                                        Maintenance scheduled:
                                        <strong>{{ formatScheduledDate(m.scheduledDate) }}</strong>
                                        <span ng-if="m.scheduledTime">
                                            at <strong>{{ m.scheduledTime }}</strong>
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- CO-OCCUPANTS -->
            <section id="co-occupants"
                     ng-if="hasCoOccupants"
                     class="fade-in-up delay-4 w-full">

                <div class="flex items-center gap-2 mb-4 ml-2">
                    <p class="text-slate-500 font-bold uppercase tracking-wider text-xs">
                        Co-occupants
                    </p>
                    <span class="text-xs text-slate-400">
                        ({{ currentTenant.additionalOccupants.length }} additional occupant{{ currentTenant.additionalOccupants.length !== 1 ? 's' : '' }})
                    </span>
                </div>

                <div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm w-full">
                    <div class="flex items-center gap-8 overflow-x-auto pb-4">
                        <div ng-repeat="occ in currentTenant.additionalOccupants track by $index"
                             class="flex flex-col items-center gap-3 min-w-[5rem]">

                            <div class="relative">
                                <div class="w-16 h-16 rounded-full bg-blue-50 border-2 border-blue-100 flex items-center justify-center text-blue-700 text-xl font-bold shadow-sm">
                                    {{ occ.name ? occ.name[0] : '?' }}
                                </div>
                                <span class="absolute -bottom-1 -right-1 text-[10px] text-blue-500 bg-blue-100 px-1.5 py-0.5 rounded-full font-bold shadow-sm border border-white">
                                    #{{ $index + 1 }}
                                </span>
                            </div>

                            <div class="text-center mt-1">
                                <span class="block text-sm font-bold text-slate-900">
                                    {{ occ.name }}
                                </span>
                                <span class="flex items-center justify-center gap-1 text-[11px] font-medium text-slate-500 mt-0.5">
                                    <lucide-icon name="phone" size="10" class="text-blue-400"></lucide-icon>
                                    {{ occ.phone || '—' }}
                                </span>
                                <span ng-if="occ.address"
                                      class="flex items-center justify-center gap-1 text-[11px] font-medium text-slate-500 mt-0.5">
                                    <lucide-icon name="map-pin" size="10" class="text-blue-400"></lucide-icon>
                                    {{ occ.address }}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

        </div>
    </main>
</div>


<div ng-show="showProfileReasonModal"
     ng-cloak
     ng-click="closeProfileReasonModal()"
     class="fixed inset-0 z-[99999] flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4">

    <div role="dialog"
         aria-modal="true"
         aria-labelledby="profileReasonTitle"
         tabindex="-1"
         ng-click="$event.stopPropagation()"
         ng-keydown="$event.key === 'Escape' && closeProfileReasonModal()"
         class="w-full max-w-lg rounded-2xl bg-white border border-slate-200 p-6 sm:p-8 shadow-2xl">

        <!-- Modal Header -->
        <div class="flex items-center gap-3 mb-4">
            <div class="w-11 h-11 rounded-xl bg-green-100 flex items-center justify-center text-green-700">
                <lucide-icon name="file-pen-line" size="21"></lucide-icon>
            </div>

            <div>
                <h3 id="profileReasonTitle"
                    class="text-xl font-bold text-slate-900">
                    Reason for Profile Change
                </h3>
                <p class="text-xs text-slate-500 mt-1">
                    Tenant Profile Request
                </p>
            </div>

            <button type="button"
                    ng-click="closeProfileReasonModal()"
                    ng-disabled="isSavingProfile"
                    aria-label="Close"
                    class="ml-auto p-2 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors disabled:opacity-50">
                <lucide-icon name="x" size="18"></lucide-icon>
            </button>
        </div>

        <p class="text-sm leading-6 text-slate-600">
            Please explain why you want to change your profile information.
            Your request will be reviewed by the property manager.
        </p>

        <!-- Reason Field -->
        <label for="profileChangeReason"
               class="mb-2 mt-5 block text-sm font-semibold text-slate-700">
            Reason <span class="text-red-500">*</span>
        </label>

        <textarea id="profileChangeReason"
                  ng-model="profileChangeReason"
                  ng-disabled="isSavingProfile"
                  input-rule="description" input-rule-label="Reason" input-rule-required input-rule-max="1000" input-rule-group="profile"
                  rows="4"
                  placeholder="Enter your reason here..."
                  class="w-full resize-y rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-800 placeholder-slate-400 outline-none transition-all focus:border-green-500 focus:bg-white focus:ring-2 focus:ring-green-100 disabled:opacity-60"></textarea>

        <p class="mt-1 text-right text-xs text-slate-400">
            {{ (profileChangeReason || '').length }}/1000
        </p>

        <!-- Actions -->
        <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

            <button type="button"
                    ng-click="closeProfileReasonModal()"
                    ng-disabled="isSavingProfile"
                    class="rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-100 disabled:opacity-50">
                Cancel
            </button>

            <button type="button"
                    ng-click="confirmProfileChange()"
                    ng-disabled="isSavingProfile || !profileChangeReason || !profileChangeReason.trim()"
                    class="inline-flex items-center justify-center gap-2 rounded-xl bg-green-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition-colors hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50">
                <lucide-icon name="send" size="15"></lucide-icon>
                {{ isSavingProfile ? 'Submitting...' : 'Submit Request' }}
            </button>

        </div>
    </div>
</div>

