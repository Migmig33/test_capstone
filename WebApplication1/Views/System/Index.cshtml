@{
    Layout = "~/Views/Shared/_RentersLayout.cshtml";
}

<div class="min-h-screen bg-white" ng-init="isLoading = true; currentPage = 'Home'; getAllHomeUnits()">
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-green-950 to-slate-800 text-white" style="min-height: 560px;">

        <div class="absolute inset-0 opacity-10">
            <div class="absolute top-10 left-10 w-72 h-72 bg-green-500 rounded-full blur-3xl"></div>
            <div class="absolute bottom-10 right-10 w-96 h-96 bg-emerald-600 rounded-full blur-3xl"></div>
        </div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-24">
            <div class="max-w-2xl fade-in-up">

                <!-- Loading State for the Top Pill -->
                <div ng-if="isLoading" class="inline-flex items-center bg-white/10 text-transparent w-48 h-8 rounded-full mb-6 animate-pulse"></div>

                <!-- Actual Data for the Top Pill -->
                <div ng-if="!isLoading" class="inline-flex items-center gap-2 bg-green-600/30 text-green-300 text-sm px-3 py-1.5 rounded-full border border-green-500/30 mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
                        <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
                        <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
                        <path d="M10 6h4" />
                        <path d="M10 10h4" />
                        <path d="M10 14h4" />
                        <path d="M10 18h4" />
                    </svg>
                    {{ availableUnits.length }} units available now
                </div>

                <h1 class="text-4xl sm:text-5xl lg:text-6xl text-white mb-6" style="line-height: 1.15;">
                    Find Your Perfect <span class="text-green-400">Home</span> in the City
                </h1>

                <p class="text-slate-300 text-lg mb-10 max-w-lg">
                    Premium rental units in Metro Manila's most sought-after locations. Fully furnished, professionally managed.
                </p>

                <form ng-submit="handleSearch()" class="flex gap-3 max-w-xl">
                    <div class="relative flex-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.3-4.3" />
                        </svg>
                        <input type="text"
                               ng-model="homeSearch"
                               placeholder="Search by unit name, area, or type..."
                               class="w-full pl-10 pr-4 py-3.5 rounded-xl bg-white text-slate-900 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 shadow-lg"
                               aria-label="Search units" />
                    </div>
                    <button type="submit" class="px-6 py-3.5 bg-green-600 hover:bg-green-500 text-white rounded-xl text-sm font-medium transition-all shadow-lg focus:outline-none focus:ring-2 focus:ring-green-400">
                        Search
                    </button>
                </form>

                <div class="flex flex-wrap gap-2 mt-4">
                    <button ng-repeat="tag in homeTags"
                            ng-click="browseTag(tag)"
                            class="text-xs px-3 py-1.5 bg-white/10 hover:bg-white/20 text-white rounded-full border border-white/20 transition-all focus:outline-none focus:ring-2 focus:ring-white/50">
                        {{ tag }}
                    </button>
                </div>

            </div>
        </div>

        <div class="absolute bottom-0 left-0 right-0">
            <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 80L1440 80L1440 40C1200 80 960 0 720 40C480 80 240 0 0 40L0 80Z" fill="white" />
            </svg>
        </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-16">
        <div class="mb-8 flex items-end justify-between">
            <div>
                <h2 class="text-slate-900 mb-1 font-bold text-2xl">Featured Units</h2>
                <p class="text-slate-500 text-sm" ng-if="!isLoading">
                    {{ availableUnits.length }} unit{{ availableUnits.length !== 1 ? 's' : '' }} ready to rent
                </p>
                <div ng-if="isLoading" class="h-4 w-40 bg-slate-200 animate-pulse rounded mt-1"></div>
            </div>
            <button ng-click="goToBrowse()" class="flex items-center gap-1.5 text-sm text-green-600 hover:text-green-700 font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-green-500 rounded-lg px-2 py-1">
                View all
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m9 18 6-6-6-6" />
                </svg>
            </button>
        </div>

        <!-- State: SKELETON LOADER (Shows 3 cards for featured section) -->
        <div ng-if="isLoading" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
            <div ng-repeat="i in [1,2,3]" class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
                <div class="h-44 bg-slate-200 animate-pulse"></div>
                <div class="p-4 space-y-4">
                    <div class="flex justify-between items-center">
                        <div class="h-5 bg-slate-200 rounded animate-pulse w-1/2"></div>
                        <div class="h-5 bg-slate-200 rounded animate-pulse w-1/4"></div>
                    </div>
                    <div class="h-3 bg-slate-200 rounded animate-pulse w-3/4"></div>
                    <div class="space-y-2">
                        <div class="h-3 bg-slate-200 rounded animate-pulse w-full"></div>
                        <div class="h-3 bg-slate-200 rounded animate-pulse w-5/6"></div>
                    </div>
                    <div class="flex gap-2">
                        <div class="h-5 w-16 bg-slate-200 rounded-full animate-pulse"></div>
                        <div class="h-5 w-20 bg-slate-200 rounded-full animate-pulse"></div>
                        <div class="h-5 w-14 bg-slate-200 rounded-full animate-pulse"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- State: EMPTY/NO RESULTS -->
        <div ng-if="!isLoading && featuredUnits.length === 0" class="text-center py-16 bg-slate-50 rounded-2xl">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300 mx-auto mb-3">
                <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
                <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
                <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
                <path d="M10 6h4" />
                <path d="M10 10h4" />
                <path d="M10 14h4" />
                <path d="M10 18h4" />
            </svg>
            <p class="text-slate-500 text-sm">All units are currently occupied. Check back soon!</p>
        </div>

        <!-- State: ACTUAL DATA GRID -->
        <div ng-if="!isLoading && featuredUnits.length > 0" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
            <div ng-repeat="unit in featuredUnits" ng-click="goToUnit(unit.id)"
                 class="group bg-white rounded-2xl border border-slate-200 overflow-hidden cursor-pointer hover:shadow-lg hover:-translate-y-0.5 transition-all">

                <div class="relative h-44 bg-slate-100 overflow-hidden">
                    <img ng-if="unit.images.length > 0"
                         ng-src="{{ unit.images[0] }}"
                         alt="{{ unit.name }}"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />

                    <div ng-if="unit.images.length === 0" class="w-full h-full flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300">
                            <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                            <circle cx="9" cy="9" r="2" />
                            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                        </svg>
                    </div>

                    <!-- Bedspace indicator -->
                    <span ng-if="unit.joinable"
                          class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                        Bedspace
                    </span>

                    <!-- Vacant indicator -->
                    <span ng-if="!unit.joinable"
                          class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-100">
                        Vacant
                    </span>


                    <span class="absolute top-3 right-3 w-3 h-3 rounded-full ring-2 ring-white"
                          ng-style="{ 'background-color': unit.colorCode || '#94A3B8' }"></span>
                </div>

                <div class="p-4">
                    <div class="flex items-start justify-between gap-2 mb-1">
                        <h3 class="text-slate-900 font-medium truncate">{{ unit.name }}</h3>
                        <p class="text-green-700 font-semibold whitespace-nowrap">
                            &#8369;{{ unit.price | number:0 }}
                        </p>
                    </div>

                    <p class="text-slate-400 text-xs mb-3">
                        {{ unit.beds }} &middot; {{ unit.sqm }} sqm &middot; Floor {{ unit.floor }}
                    </p>

                    <p class="text-slate-500 text-sm mb-3" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                        {{ unit.description }}
                    </p>

                    <div class="flex flex-wrap gap-1.5">
                        <span ng-repeat="am in unit.amenities | limitTo:3"
                              class="px-2 py-0.5 rounded-full bg-slate-50 text-slate-600 text-xs border border-slate-200">
                            {{ am }}
                        </span>
                        <span ng-if="unit.amenities.length > 3"
                              class="px-2 py-0.5 rounded-full bg-slate-50 text-slate-400 text-xs border border-slate-200">
                            +{{ unit.amenities.length - 3 }}
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <button ng-click="goToBrowse()" class="inline-flex items-center gap-2 px-8 py-3.5 bg-green-600 hover:bg-green-700 text-white rounded-xl text-sm font-medium transition-all shadow-lg shadow-green-200 focus:outline-none focus:ring-2 focus:ring-green-500">
                Browse All Available Units
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                </svg>
            </button>
        </div>
    </section>

    <section class="bg-gradient-to-r from-green-600 to-green-700 py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-3xl text-white mb-3 font-semibold">Ready to Move In?</h2>
            <p class="text-green-100 mb-8 max-w-md mx-auto">
                Book a viewing today and take the first step toward your new home.
            </p>
            <button ng-click="goToBrowse()" class="px-8 py-3.5 bg-white text-green-700 rounded-xl text-sm font-semibold transition-all hover:bg-green-50 focus:outline-none focus:ring-2 focus:ring-white">
                Explore Units &rarr;
            </button>
        </div>
    </section>
</div>
